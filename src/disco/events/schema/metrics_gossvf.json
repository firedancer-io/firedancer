{
    "name": "metrics_gossvf",
    "id": 38,
    "description": "Metrics of one gossvf tile instance, one row per sweep",
    "local": true,
    "fields": {
        "sample_id":                  { "type": "UInt64",                                                         "description": "Identifier shared by every row of one sweep" },
        "sample_reason":              { "type": "ref:MetricsSampleReason",                                        "description": "Why the sweep was taken" },
        "sample_slot":                { "type": "UInt64",                                                         "description": "Slot that triggered the sweep, 0 for periodic sweeps" },
        "sample_snapct_state":        { "type": "ref:MetricsSnapctLoadState",                                     "description": "Snapshot load state entered, for snapct_state sweeps; unknown otherwise" },
        "sample_caught_up":           { "type": "Bool",                                                           "description": "Whether replay had caught up to the cluster tip when the sweep was taken (replay IsCaughtUp); set once per run, never cleared" },
        "sample_tile_cnt":            { "type": "UInt64",                                                         "description": "Tile instances in the sweep, to detect partial sweeps" },
        "kind_id":                    { "type": "UInt64",                                                         "description": "Index of this tile instance among tiles of its kind" },
        "pid":                        { "type": "UInt64",                     "compression": "T64, ZSTD",         "description": "Process ID of the tile" },
        "tid":                        { "type": "UInt64",                     "compression": "T64, ZSTD",         "description": "Thread ID of the tile. Same as Pid in production, but might differ in development" },
        "last_cpu_index":             { "type": "UInt64",                     "compression": "T64, ZSTD",         "description": "CPU the tile last ran on" },
        "context_switch_involuntary": { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "counter: cumulative since tile start, query deltas. Involuntary context switches" },
        "context_switch_voluntary":   { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "counter: cumulative since tile start, query deltas. Voluntary context switches" },
        "page_fault_major":           { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "counter: cumulative since tile start, query deltas. Major page faults" },
        "page_fault_minor":           { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "counter: cumulative since tile start, query deltas. Minor page faults" },
        "state": {
            "type": "LowCardinality(String)",
            "description": "Tile lifecycle state: 0=booting, 1=running, 2=shutdown",
            "variants": {
                "booting":  { "description": "Booting" },
                "running":  { "description": "Running" },
                "shutdown": { "description": "Shutdown" }
            }
        },
        "heartbeat_time":             { "type": "DateTime64(9)",              "compression": "Delta, ZSTD",       "description": "Last wall-clock time the tile heartbeated" },
        "is_backpressured":           { "type": "Bool",                                                           "description": "Whether the tile is currently backpressured" },
        "backpressure":               { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "counter: cumulative since tile start, query deltas. Times the tile waited for one or more consumers to catch up to resume publishing" },
        "regime_duration_nanos": {
            "type": "Tuple",
            "description": "Tile wall time, by regime; regimes are exhaustive and groups Busy, Idle, Backpressure and Housekeeping partition it",
            "fields": {
                "caught_up_housekeeping":    { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Caught up + Housekeeping" },
                "processing_housekeeping":   { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Processing + Housekeeping" },
                "backpressure_housekeeping": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Backpressure + Housekeeping" },
                "caught_up_prefrag":         { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Caught up + Prefrag" },
                "processing_prefrag":        { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Processing + Prefrag" },
                "backpressure_prefrag":      { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Backpressure + Prefrag" },
                "caught_up_postfrag":        { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Caught up + Postfrag" },
                "processing_postfrag":       { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Processing + Postfrag" },
                "caught_up_sleeping":        { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Caught up + Sleeping" },
                "backpressure_sleeping":     { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Backpressure + Sleeping" }
            }
        },
        "thread_duration_nanos": {
            "type": "Tuple",
            "description": "Thread wall time since start, by scheduler state; Idle is the remainder, so parts sum to about the lifetime.  User, System and Interrupt have 10 ms resolution; Interrupt is 0 unless the tile is pinned",
            "fields": {
                "wait":      { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Wait (task was runnable but not scheduled)" },
                "idle":      { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Idle (task was not runnable)" },
                "user":      { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "User (task was scheduled and executing in user mode)" },
                "system":    { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "System (task was scheduled and executing in kernel mode)" },
                "interrupt": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Interrupt (CPU time stolen by hardirq/softirq handlers or a hypervisor; fixed tiles only)" }
            }
        },
        "park_attempted": {
            "type": "Tuple",
            "description": "Times the tile tried to park while idle (efficient mode), by result",
            "fields": {
                "ring":     { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Woken by a doorbell ring" },
                "deadline": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Deadline or park cap lapsed" },
                "pending":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Pre-park recheck found work, did not park" }
            }
        },
        "device_irq":                 { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "counter: cumulative since tile start, query deltas. Device IRQs on the tile's dedicated CPU, 0 for tiles not pinned" },
        "tlb_shootdown":              { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "counter: cumulative since tile start, query deltas. TLB shootdowns on the tile's dedicated CPU, 0 for tiles not pinned" },
        "timer_irq":                  { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "counter: cumulative since tile start, query deltas. Local timer interrupts (LOC) on the tile's dedicated CPU, 0 for tiles not pinned" },
        "message_rx": {
            "type": "Tuple",
            "description": "Gossip messages received, by verification result",
            "fields": {
                "success_pull_request":                  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Pull Request (success)" },
                "success_pull_response":                 { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Pull Response (success)" },
                "success_push":                          { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Push (success)" },
                "success_prune":                         { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Prune (success)" },
                "success_ping":                          { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Ping (success)" },
                "success_pong":                          { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Pong (success)" },
                "dropped_unparseable":                   { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Unparseable" },
                "dropped_pull_request_not_contact_info": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Pull Request (not contact info)" },
                "dropped_pull_request_loopback":         { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Pull Request (loopback)" },
                "dropped_pull_request_inactive":         { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Pull Request (inactive)" },
                "dropped_pull_request_wallclock":        { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Pull Request (wallclock)" },
                "dropped_pull_request_signature":        { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Pull Request (signature)" },
                "dropped_pull_request_shred_version":    { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Pull Request (shred version)" },
                "dropped_pull_request_mask_bits":        { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Pull Request (mask bits)" },
                "dropped_prune_destination":             { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Prune (destination)" },
                "dropped_prune_wallclock":               { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Prune (wallclock)" },
                "dropped_prune_signature":               { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Prune (signature)" },
                "dropped_push_loopback":                 { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Push (loopback)" },
                "dropped_push_no_valid_crds":            { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Push (no valid crds)" },
                "dropped_pull_response_loopback":        { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Pull Response (loopback)" },
                "dropped_pull_response_no_valid_crds":   { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Pull Response (no valid crds)" },
                "dropped_ping_signature":                { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Ping (signature)" },
                "dropped_pong_signature":                { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Pong (signature)" }
            }
        },
        "message_rx_bytes": {
            "type": "Tuple",
            "description": "Wire bytes of gossip messages received, by verification result",
            "fields": {
                "success_pull_request":                  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Pull Request (success)" },
                "success_pull_response":                 { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Pull Response (success)" },
                "success_push":                          { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Push (success)" },
                "success_prune":                         { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Prune (success)" },
                "success_ping":                          { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Ping (success)" },
                "success_pong":                          { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Pong (success)" },
                "dropped_unparseable":                   { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Unparseable" },
                "dropped_pull_request_not_contact_info": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Pull Request (not contact info)" },
                "dropped_pull_request_loopback":         { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Pull Request (loopback)" },
                "dropped_pull_request_inactive":         { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Pull Request (inactive)" },
                "dropped_pull_request_wallclock":        { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Pull Request (wallclock)" },
                "dropped_pull_request_signature":        { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Pull Request (signature)" },
                "dropped_pull_request_shred_version":    { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Pull Request (shred version)" },
                "dropped_pull_request_mask_bits":        { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Pull Request (mask bits)" },
                "dropped_prune_destination":             { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Prune (destination)" },
                "dropped_prune_wallclock":               { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Prune (wallclock)" },
                "dropped_prune_signature":               { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Prune (signature)" },
                "dropped_push_loopback":                 { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Push (loopback)" },
                "dropped_push_no_valid_crds":            { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Push (no valid crds)" },
                "dropped_pull_response_loopback":        { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Pull Response (loopback)" },
                "dropped_pull_response_no_valid_crds":   { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Pull Response (no valid crds)" },
                "dropped_ping_signature":                { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Ping (signature)" },
                "dropped_pong_signature":                { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Pong (signature)" }
            }
        },
        "crds_rx": {
            "type": "Tuple",
            "description": "CRDS values in push and pull-response messages, by outcome; Verified and Duplicate only for messages forwarded to gossip, Dropped counted as each check fails",
            "fields": {
                "verified_pull_response":                { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Pull Response (success)" },
                "duplicate_pull_response":               { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Pull Response (duplicate)" },
                "verified_push":                         { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Push (success)" },
                "duplicate_push":                        { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Push (duplicate)" },
                "dropped_pull_response_signature":       { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Pull Response (signature)" },
                "dropped_pull_response_no_contact_info": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Pull Response (origin no contact info)" },
                "dropped_pull_response_shred_version":   { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Pull Response (origin shred version)" },
                "dropped_pull_response_inactive":        { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Pull Response (inactive)" },
                "dropped_pull_response_wallclock":       { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Pull Response (wallclock)" },
                "dropped_push_signature":                { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Push (signature)" },
                "dropped_push_no_contact_info":          { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Push (origin no contact info)" },
                "dropped_push_shred_version":            { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Push (origin shred version)" },
                "dropped_push_inactive":                 { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Push (inactive)" },
                "dropped_push_wallclock":                { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Push (wallclock)" }
            }
        },
        "crds_rx_bytes": {
            "type": "Tuple",
            "description": "Wire bytes of CRDS values received, by verification result",
            "fields": {
                "verified_pull_response":                { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Pull Response (success)" },
                "duplicate_pull_response":               { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Pull Response (duplicate)" },
                "verified_push":                         { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Push (success)" },
                "duplicate_push":                        { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Push (duplicate)" },
                "dropped_pull_response_signature":       { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Pull Response (signature)" },
                "dropped_pull_response_no_contact_info": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Pull Response (origin no contact info)" },
                "dropped_pull_response_shred_version":   { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Pull Response (origin shred version)" },
                "dropped_pull_response_inactive":        { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Pull Response (inactive)" },
                "dropped_pull_response_wallclock":       { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Pull Response (wallclock)" },
                "dropped_push_signature":                { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Push (signature)" },
                "dropped_push_no_contact_info":          { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Push (origin no contact info)" },
                "dropped_push_shred_version":            { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Push (origin shred version)" },
                "dropped_push_inactive":                 { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Push (inactive)" },
                "dropped_push_wallclock":                { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Push (wallclock)" }
            }
        }
    }
}
