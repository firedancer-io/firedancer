{
    "name": "metrics_shred",
    "id": 32,
    "description": "Metrics of one shred tile instance, one row per sweep",
    "local": true,
    "fields": {
        "sample_id":                    { "type": "UInt64",                                                         "description": "Identifier shared by every row of one sweep" },
        "sample_reason":                { "type": "ref:MetricsSampleReason",                                        "description": "Why the sweep was taken" },
        "sample_slot":                  { "type": "UInt64",                                                         "description": "Slot that triggered the sweep, 0 for periodic sweeps" },
        "sample_snapct_state":          { "type": "ref:MetricsSnapctLoadState",                                     "description": "Snapshot load state entered, for snapct_state sweeps; unknown otherwise" },
        "sample_caught_up":             { "type": "Bool",                                                           "description": "Whether replay had caught up to the cluster tip when the sweep was taken (replay IsCaughtUp); set once per run, never cleared" },
        "sample_tile_cnt":              { "type": "UInt64",                                                         "description": "Tile instances in the sweep, to detect partial sweeps" },
        "kind_id":                      { "type": "UInt64",                                                         "description": "Index of this tile instance among tiles of its kind" },
        "pid":                          { "type": "UInt64",                     "compression": "T64, ZSTD",         "description": "Process ID of the tile" },
        "tid":                          { "type": "UInt64",                     "compression": "T64, ZSTD",         "description": "Thread ID of the tile. Same as Pid in production, but might differ in development" },
        "last_cpu_index":               { "type": "UInt64",                     "compression": "T64, ZSTD",         "description": "CPU the tile last ran on" },
        "context_switch_involuntary":   { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "counter: cumulative since tile start, query deltas. Involuntary context switches" },
        "context_switch_voluntary":     { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "counter: cumulative since tile start, query deltas. Voluntary context switches" },
        "page_fault_major":             { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "counter: cumulative since tile start, query deltas. Major page faults" },
        "page_fault_minor":             { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "counter: cumulative since tile start, query deltas. Minor page faults" },
        "state": {
            "type": "LowCardinality(String)",
            "description": "Tile lifecycle state: 0=booting, 1=running, 2=shutdown",
            "variants": {
                "booting":  { "description": "Booting" },
                "running":  { "description": "Running" },
                "shutdown": { "description": "Shutdown" }
            }
        },
        "heartbeat_time":               { "type": "DateTime64(9)",              "compression": "Delta, ZSTD",       "description": "Last wall-clock time the tile heartbeated" },
        "is_backpressured":             { "type": "Bool",                                                           "description": "Whether the tile is currently backpressured" },
        "backpressure":                 { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "counter: cumulative since tile start, query deltas. Times the tile waited for one or more consumers to catch up to resume publishing" },
        "regime_duration_nanos": {
            "type": "Tuple",
            "description": "Tile wall time, by regime; regimes are exhaustive and groups Busy, Idle, Backpressure and Housekeeping partition it",
            "aliases": {
                "all":          ["caught_up_housekeeping", "processing_housekeeping", "backpressure_housekeeping", "caught_up_prefrag", "processing_prefrag", "backpressure_prefrag", "caught_up_postfrag", "processing_postfrag", "caught_up_sleeping", "backpressure_sleeping"],
                "housekeeping": ["caught_up_housekeeping", "processing_housekeeping", "backpressure_housekeeping"],
                "busy":         ["caught_up_prefrag", "processing_prefrag", "processing_postfrag"],
                "idle":         ["caught_up_postfrag", "caught_up_sleeping"],
                "backpressure": ["backpressure_prefrag", "backpressure_sleeping"],
                "sleeping":     ["caught_up_sleeping", "backpressure_sleeping"]
            },
            "fields": {
                "caught_up_housekeeping":    { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Caught up + Housekeeping" },
                "processing_housekeeping":   { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Processing + Housekeeping" },
                "backpressure_housekeeping": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Backpressure + Housekeeping" },
                "caught_up_prefrag":         { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Caught up + Prefrag" },
                "processing_prefrag":        { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Processing + Prefrag" },
                "backpressure_prefrag":      { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Backpressure + Prefrag" },
                "caught_up_postfrag":        { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Caught up + Postfrag" },
                "processing_postfrag":       { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Processing + Postfrag" },
                "caught_up_sleeping":        { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Caught up + Sleeping" },
                "backpressure_sleeping":     { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Backpressure + Sleeping" }
            }
        },
        "thread_duration_nanos": {
            "type": "Tuple",
            "description": "Thread wall time since start, by scheduler state; Idle is the remainder, so parts sum to about the lifetime.  User, System and Interrupt have 10 ms resolution; Interrupt is 0 unless it is the only live tile pinned to its CPU",
            "aliases": {
                "all":       ["wait", "idle", "user", "system", "interrupt"],
                "running":   ["user", "system"],
                "preempted": ["wait", "interrupt"]
            },
            "fields": {
                "wait":      { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Wait (task was runnable but not scheduled)" },
                "idle":      { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Idle (task was not runnable)" },
                "user":      { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "User (task was scheduled and executing in user mode)" },
                "system":    { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "System (task was scheduled and executing in kernel mode)" },
                "interrupt": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Interrupt (CPU time stolen by hardirq/softirq handlers or a hypervisor; fixed tiles only)" }
            }
        },
        "park_attempted": {
            "type": "Tuple",
            "description": "Times the tile tried to park while idle (efficient mode), by result",
            "aliases": {
                "all": ["ring", "deadline", "pending"]
            },
            "fields": {
                "ring":     { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Woken by a doorbell ring" },
                "deadline": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Deadline or park cap lapsed" },
                "pending":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Pre-park recheck found work, did not park" }
            }
        },
        "device_irq":                   { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "counter: cumulative since tile start, query deltas. Device IRQs on the tile's dedicated CPU, 0 unless it is the only live tile pinned there" },
        "tlb_shootdown":                { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "counter: cumulative since tile start, query deltas. TLB shootdowns on the tile's dedicated CPU, 0 unless it is the only live tile pinned there" },
        "timer_irq":                    { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "counter: cumulative since tile start, query deltas. Local timer interrupts (LOC) on the tile's dedicated CPU, 0 unless it is the only live tile pinned there" },
        "dest_per_update": {
            "type": "Tuple",
            "description": "Shred destinations in each cluster contact info update (Frankendancer only; on Firedancer see the gossip tile peer count)",
            "fields": {
                "b0":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[0, 1)" },
                "b1":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[1, 2)" },
                "b2":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[2, 4)" },
                "b3":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[4, 9)" },
                "b4":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[9, 19)" },
                "b5":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[19, 41)" },
                "b6":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[41, 88)" },
                "b7":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[88, 189)" },
                "b8":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[189, 406)" },
                "b9":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[406, 873)" },
                "b10": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[873, 1878)" },
                "b11": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[1878, 4040)" },
                "b12": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[4040, 8690)" },
                "b13": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[8690, 18691)" },
                "b14": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[18691, 40200)" },
                "b15": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[40200, inf)" },
                "sum": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Sum of samples" }
            }
        },
        "batch_abandoned":              { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "Microblock batches abandoned because we switched slots without finishing the current slot" },
        "parent_block_id_zeroed":       { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "Leader blocks whose parent block_id was unknown, so the chained merkle root was zeroed" },
        "batch_size_bytes": {
            "type": "Tuple",
            "description": "Size of each microblock batch that is shredded",
            "fields": {
                "b0":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[0, 1024) bytes" },
                "b1":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[1024, 1378) bytes" },
                "b2":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[1378, 1855) bytes" },
                "b3":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[1855, 2497) bytes" },
                "b4":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[2497, 3361) bytes" },
                "b5":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[3361, 4523) bytes" },
                "b6":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[4523, 6087) bytes" },
                "b7":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[6087, 8192) bytes" },
                "b8":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[8192, 11026) bytes" },
                "b9":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[11026, 14840) bytes" },
                "b10": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[14840, 19973) bytes" },
                "b11": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[19973, 26881) bytes" },
                "b12": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[26881, 36179) bytes" },
                "b13": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[36179, 48693) bytes" },
                "b14": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[48693, 65536) bytes" },
                "b15": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[65536, inf) bytes" },
                "sum": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Sum of samples (bytes)" }
            }
        },
        "microblock_per_batch": {
            "type": "Tuple",
            "description": "Microblocks in each microblock batch that is shredded",
            "fields": {
                "b0":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[0, 2)" },
                "b1":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[2, 3)" },
                "b2":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[3, 4)" },
                "b3":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[4, 6)" },
                "b4":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[6, 8)" },
                "b5":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[8, 11)" },
                "b6":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[11, 16)" },
                "b7":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[16, 23)" },
                "b8":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[23, 32)" },
                "b9":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[32, 45)" },
                "b10": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[45, 64)" },
                "b11": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[64, 91)" },
                "b12": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[91, 128)" },
                "b13": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[128, 181)" },
                "b14": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[181, 256)" },
                "b15": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[256, inf)" },
                "sum": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Sum of samples" }
            }
        },
        "batch_shred_duration_nanos": {
            "type": "Tuple",
            "description": "Duration of shredding one microblock batch",
            "fields": {
                "b0":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[0, 10000) nanos" },
                "b1":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[10000, 16379) nanos" },
                "b2":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[16379, 26827) nanos" },
                "b3":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[26827, 43940) nanos" },
                "b4":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[43940, 71969) nanos" },
                "b5":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[71969, 117878) nanos" },
                "b6":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[117878, 193071) nanos" },
                "b7":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[193071, 316230) nanos" },
                "b8":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[316230, 517951) nanos" },
                "b9":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[517951, 848348) nanos" },
                "b10": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[848348, 1389502) nanos" },
                "b11": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[1389502, 2275854) nanos" },
                "b12": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[2275854, 3727603) nanos" },
                "b13": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[3727603, 6105410) nanos" },
                "b14": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[6105410, 10000000) nanos" },
                "b15": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[10000000, inf) nanos" },
                "sum": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Sum of samples (nanos)" }
            }
        },
        "add_shred_duration_nanos": {
            "type": "Tuple",
            "description": "Duration of verifying and processing one shred received from the network",
            "fields": {
                "b0":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[0, 10) nanos" },
                "b1":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[10, 23) nanos" },
                "b2":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[23, 52) nanos" },
                "b3":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[52, 118) nanos" },
                "b4":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[118, 269) nanos" },
                "b5":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[269, 612) nanos" },
                "b6":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[612, 1392) nanos" },
                "b7":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[1392, 3167) nanos" },
                "b8":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[3167, 7206) nanos" },
                "b9":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[7206, 16396) nanos" },
                "b10": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[16396, 37307) nanos" },
                "b11": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[37307, 84887) nanos" },
                "b12": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[84887, 193150) nanos" },
                "b13": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[193150, 439488) nanos" },
                "b14": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[439488, 1000000) nanos" },
                "b15": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[1000000, inf) nanos" },
                "sum": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Sum of samples (nanos)" }
            }
        },
        "store_fec_sync_spill_duration_nanos": {
            "type": "Tuple",
            "description": "Duration of synchronously spilling one FEC payload to the store",
            "fields": {
                "b0":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[0, 100) nanos" },
                "b1":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[100, 268) nanos" },
                "b2":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[268, 719) nanos" },
                "b3":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[719, 1929) nanos" },
                "b4":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[1929, 5175) nanos" },
                "b5":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[5175, 13884) nanos" },
                "b6":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[13884, 37250) nanos" },
                "b7":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[37250, 99939) nanos" },
                "b8":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[99939, 268129) nanos" },
                "b9":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[268129, 719371) nanos" },
                "b10": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[719371, 1930022) nanos" },
                "b11": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[1930022, 5178115) nanos" },
                "b12": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[5178115, 13892523) nanos" },
                "b13": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[13892523, 37272675) nanos" },
                "b14": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[37272675, 100000000) nanos" },
                "b15": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[100000000, inf) nanos" },
                "sum": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Sum of samples (nanos)" }
            }
        },
        "processed": {
            "type": "Tuple",
            "description": "Shreds assigned to this tile that passed the initial parse and chained check, by processing result, plus received frags that failed the initial parse; InitialRejected and FecFatalRejected are subsets of Rejected",
            "aliases": {
                "all": ["own_leader_echoed", "leader_unknown", "parse_failed", "equivocated", "rejected", "ignored", "duplicate", "accepted", "completed"]
            },
            "fields": {
                "leader_unknown":    { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Shred was for a slot whose leader is unknown" },
                "parse_failed":      { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Shred parsing failed" },
                "equivocated":       { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Shred was equivocated with another shred" },
                "rejected":          { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Shred was invalid for one of many reasons" },
                "ignored":           { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Shred was ignored because we had already reconstructed the FEC set, or was for an old slot" },
                "duplicate":         { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Shred was a duplicate of a previously received valid shred of an incomplete FEC set" },
                "accepted":          { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Shred accepted into an incomplete FEC set" },
                "completed":         { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Shred accepted and resulted in a valid, complete FEC set" },
                "own_leader_echoed": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Turbine shred for a slot we led, echoed back to us by a relay" }
            }
        },
        "fec_incomplete_evicted":       { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "Incomplete FEC sets evicted from the resolver to make room for new ones" },
        "initial_rejected":             { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "Shreds rejected before any resources were allocated for the FEC set" },
        "unchained_rejected":           { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "Shreds rejected because they're not chained merkle shreds" },
        "fec_fatal_rejected":           { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "FEC sets rejected for reasons that cause the whole FEC set to become invalid" },
        "repair_nonce_failed":          { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "Shreds that looked like repair responses but had an incorrect nonce" },
        "repair_rx":                    { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "Repair shreds received" },
        "repair_rx_bytes":              { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "Bytes received from network packets with repair shreds, including network headers" },
        "turbine_rx":                   { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "Turbine shreds received" },
        "turbine_rx_bytes":             { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "Bytes received from network packets with turbine shreds, including network headers" },
        "repair_completion_assisted":   { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "FEC sets that completed with at least one repair shred contributing" },
        "repair_lead_delay_nanos": {
            "type": "Tuple",
            "description": "Estimated time repair advanced FEC set completion: the delay from a repair-assisted completion until turbine had delivered as many shreds for that set as repair contributed. Counts arrivals rather than distinct indices, so turbine duplicates bias this low",
            "fields": {
                "b0":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[0, 100000) nanos" },
                "b1":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[100000, 227585) nanos" },
