{
    "name": "metrics_execle",
    "id": 31,
    "description": "Metrics of one execle tile instance, one row per sweep",
    "local": true,
    "fields": {
        "sample_id":                     { "type": "UInt64",                                                         "description": "Identifier shared by every row of one sweep" },
        "sample_reason":                 { "type": "ref:MetricsSampleReason",                                        "description": "Why the sweep was taken" },
        "sample_slot":                   { "type": "UInt64",                                                         "description": "Slot that triggered the sweep, 0 for periodic sweeps" },
        "sample_snapct_state":           { "type": "ref:MetricsSnapctLoadState",                                     "description": "Snapshot load state entered, for snapct_state sweeps; unknown otherwise" },
        "sample_caught_up":              { "type": "Bool",                                                           "description": "Whether replay had caught up to the cluster tip when the sweep was taken (replay IsCaughtUp); set once per run, never cleared" },
        "sample_tile_cnt":               { "type": "UInt64",                                                         "description": "Tile instances in the sweep, to detect partial sweeps" },
        "kind_id":                       { "type": "UInt64",                                                         "description": "Index of this tile instance among tiles of its kind" },
        "pid":                           { "type": "UInt64",                     "compression": "T64, ZSTD",         "description": "Process ID of the tile" },
        "tid":                           { "type": "UInt64",                     "compression": "T64, ZSTD",         "description": "Thread ID of the tile. Same as Pid in production, but might differ in development" },
        "last_cpu_index":                { "type": "UInt64",                     "compression": "T64, ZSTD",         "description": "CPU the tile last ran on" },
        "context_switch_involuntary":    { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "counter: cumulative since tile start, query deltas. Involuntary context switches" },
        "context_switch_voluntary":      { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "counter: cumulative since tile start, query deltas. Voluntary context switches" },
        "page_fault_major":              { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "counter: cumulative since tile start, query deltas. Major page faults" },
        "page_fault_minor":              { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "counter: cumulative since tile start, query deltas. Minor page faults" },
        "state": {
            "type": "LowCardinality(String)",
            "description": "Tile lifecycle state: 0=booting, 1=running, 2=shutdown",
            "variants": {
                "booting":  { "description": "Booting" },
                "running":  { "description": "Running" },
                "shutdown": { "description": "Shutdown" }
            }
        },
        "heartbeat_time":                { "type": "DateTime64(9)",              "compression": "Delta, ZSTD",       "description": "Last wall-clock time the tile heartbeated" },
        "is_backpressured":              { "type": "Bool",                                                           "description": "Whether the tile is currently backpressured" },
        "backpressure":                  { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "counter: cumulative since tile start, query deltas. Times the tile waited for one or more consumers to catch up to resume publishing" },
        "regime_duration_nanos": {
            "type": "Tuple",
            "description": "Tile wall time, by regime; regimes are exhaustive and groups Busy, Idle, Backpressure and Housekeeping partition it",
            "aliases": {
                "all":          ["caught_up_housekeeping", "processing_housekeeping", "backpressure_housekeeping", "caught_up_prefrag", "processing_prefrag", "backpressure_prefrag", "caught_up_postfrag", "processing_postfrag", "caught_up_sleeping", "backpressure_sleeping"],
                "housekeeping": ["caught_up_housekeeping", "processing_housekeeping", "backpressure_housekeeping"],
                "busy":         ["caught_up_prefrag", "processing_prefrag", "processing_postfrag"],
                "idle":         ["caught_up_postfrag", "caught_up_sleeping"],
                "backpressure": ["backpressure_prefrag", "backpressure_sleeping"],
                "sleeping":     ["caught_up_sleeping", "backpressure_sleeping"]
            },
            "fields": {
                "caught_up_housekeeping":    { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Caught up + Housekeeping" },
                "processing_housekeeping":   { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Processing + Housekeeping" },
                "backpressure_housekeeping": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Backpressure + Housekeeping" },
                "caught_up_prefrag":         { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Caught up + Prefrag" },
                "processing_prefrag":        { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Processing + Prefrag" },
                "backpressure_prefrag":      { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Backpressure + Prefrag" },
                "caught_up_postfrag":        { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Caught up + Postfrag" },
                "processing_postfrag":       { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Processing + Postfrag" },
                "caught_up_sleeping":        { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Caught up + Sleeping" },
                "backpressure_sleeping":     { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Backpressure + Sleeping" }
            }
        },
        "thread_duration_nanos": {
            "type": "Tuple",
            "description": "Thread wall time since start, by scheduler state; Idle is the remainder, so parts sum to about the lifetime.  User, System and Interrupt have 10 ms resolution; Interrupt is 0 unless it is the only live tile pinned to its CPU",
            "aliases": {
                "all":       ["wait", "idle", "user", "system", "interrupt"],
                "running":   ["user", "system"],
                "preempted": ["wait", "interrupt"]
            },
            "fields": {
                "wait":      { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Wait (task was runnable but not scheduled)" },
                "idle":      { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Idle (task was not runnable)" },
                "user":      { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "User (task was scheduled and executing in user mode)" },
                "system":    { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "System (task was scheduled and executing in kernel mode)" },
                "interrupt": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Interrupt (CPU time stolen by hardirq/softirq handlers or a hypervisor; fixed tiles only)" }
            }
        },
        "park_attempted": {
            "type": "Tuple",
            "description": "Times the tile tried to park while idle (efficient mode), by result",
            "aliases": {
                "all": ["ring", "deadline", "pending"]
            },
            "fields": {
                "ring":     { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Woken by a doorbell ring" },
                "deadline": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Deadline or park cap lapsed" },
                "pending":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Pre-park recheck found work, did not park" }
            }
        },
        "device_irq":                    { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "counter: cumulative since tile start, query deltas. Device IRQs on the tile's dedicated CPU, 0 unless it is the only live tile pinned there" },
        "tlb_shootdown":                 { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "counter: cumulative since tile start, query deltas. TLB shootdowns on the tile's dedicated CPU, 0 unless it is the only live tile pinned there" },
        "timer_irq":                     { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "counter: cumulative since tile start, query deltas. Local timer interrupts (LOC) on the tile's dedicated CPU, 0 unless it is the only live tile pinned there" },
        "txn_processed": {
            "type": "Tuple",
            "description": "Transactions loaded and executed, by result",
            "aliases": {
                "all":     ["success", "instruction_error", "account_not_found", "program_account_not_found", "insufficient_funds_for_fee", "invalid_account_for_fee", "already_processed", "blockhash_not_found", "invalid_program_for_execution", "address_lookup_table_not_found", "invalid_address_lookup_table_owner", "invalid_address_lookup_table_data", "invalid_address_lookup_table_index", "max_loaded_accounts_data_size_exceeded", "duplicate_instruction", "invalid_loaded_accounts_data_size_limit", "nonce_already_advanced", "nonce_advance_failed", "nonce_wrong_blockhash", "unsupported_version", "sanitize_failure", "account_in_use", "account_loaded_twice", "signature_failure", "too_many_account_locks", "insufficient_funds_for_rent", "unbalanced_transaction", "bundle_peer"],
                "failure": ["instruction_error", "account_not_found", "program_account_not_found", "insufficient_funds_for_fee", "invalid_account_for_fee", "already_processed", "blockhash_not_found", "invalid_program_for_execution", "address_lookup_table_not_found", "invalid_address_lookup_table_owner", "invalid_address_lookup_table_data", "invalid_address_lookup_table_index", "max_loaded_accounts_data_size_exceeded", "duplicate_instruction", "invalid_loaded_accounts_data_size_limit", "nonce_already_advanced", "nonce_advance_failed", "nonce_wrong_blockhash", "unsupported_version", "sanitize_failure", "account_in_use", "account_loaded_twice", "signature_failure", "too_many_account_locks", "insufficient_funds_for_rent", "unbalanced_transaction", "bundle_peer"]
            },
            "fields": {
                "success":                                 { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Transaction executed successfully" },
                "instruction_error":                       { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "An error occurred while processing an instruction" },
                "account_not_found":                       { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "The transaction fee payer address was not found" },
                "program_account_not_found":               { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "A program account referenced by the transaction was not found" },
                "insufficient_funds_for_fee":              { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "The transaction fee payer did not have balance to pay the fee" },
                "invalid_account_for_fee":                 { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "The transaction fee payer account is not owned by the system program, or has data that is not a nonce" },
                "already_processed":                       { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "The transaction has already been processed in a recent block" },
                "blockhash_not_found":                     { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "The transaction references a blockhash that is not recent, or advances a nonce with the wrong value" },
                "invalid_program_for_execution":           { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "A program account referenced by the transaction was no executable." },
                "address_lookup_table_not_found":          { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "The transaction references an ALUT account that does not exist or is inactive" },
                "invalid_address_lookup_table_owner":      { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "The transaction references an ALUT account that is not owned by the ALUT program account" },
                "invalid_address_lookup_table_data":       { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "The transaction references an ALUT account that contains data which is not a valid ALUT" },
                "invalid_address_lookup_table_index":      { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "The transaction references an account offset from the ALUT which does not exist" },
                "max_loaded_accounts_data_size_exceeded":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "The total account data size of the loaded accounts exceeds the consensus limit" },
                "duplicate_instruction":                   { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "A compute budget program instruction was invoked more than once" },
                "invalid_loaded_accounts_data_size_limit": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "The compute budget program was invoked and set the loaded accounts data size to zero" },
                "nonce_already_advanced":                  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "The transaction references a nonce account that is already advanced" },
                "nonce_advance_failed":                    { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "The transaction is a nonce transaction but the advance instruction was not valid or failed" },
                "nonce_wrong_blockhash":                   { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "The transaction is a nonce transaction but the blockhash is not the correct one" },
                "unsupported_version":                     { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "The transaction is a message version that is not supported by the current feature set" },
                "sanitize_failure":                        { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "The process for sanitizing the transaction failed" },
                "account_in_use":                          { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "The transaction conflicts with another transaction in the microblock." },
                "account_loaded_twice":                    { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "The transaction references the same account twice" },
                "signature_failure":                       { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "The transaction had an invalid signature" },
                "too_many_account_locks":                  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "The transaction references too many accounts." },
                "insufficient_funds_for_rent":             { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "The transaction would leave an account with a lower balance than the rent-exempt minimum" },
                "unbalanced_transaction":                  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "The total referenced account lamports before and after the transaction was unbalanced" },
                "bundle_peer":                             { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "The transaction was part of a bundle and an earlier transaction in the bundle failed" }
            }
        },
        "txn_processed_by_landing": {
            "type": "Tuple",
            "description": "Transactions processed, by whether and how they landed in the block",
            "aliases": {
                "all": ["success", "fees_only", "failed", "dropped"]
            },
            "fields": {
                "success":   { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Transaction landed and executed successfully" },
                "fees_only": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Transaction landed, but was fees only and did not execute" },
                "failed":    { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Transaction landed, but failed to execute" },
                "dropped":   { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Transaction did not land" }
            }
        },
        "txn_processed_by_version": {
            "type": "Tuple",
            "description": "Transactions processed, by transaction version",
            "aliases": {
                "all": ["legacy", "v0", "v1"]
            },
            "fields": {
                "legacy": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Legacy transaction format" },
                "v0":     { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Version 0 transaction format" },
                "v1":     { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Version 1 transaction format" }
            }
        },
        "instruction_executed":          { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "Top-level instructions executed" },
        "cpi_executed":                  { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "Cross-program invocations executed" },
        "account_lthash_skipped":        { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "Committed writable accounts left byte-identical by their transaction, so their lthash update was skipped" },
        "cu_consumed":                   { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "Compute units consumed by executed transactions" },
        "txn_regime_duration_nanos": {
            "type": "Tuple",
            "description": "Time per transaction, by phase; a phase counts only once the next phase starts, so dropped, fees-only and no-op transactions lose their trailing phases",
            "aliases": {
                "all": ["load", "execute", "commit"]
            },
            "fields": {
                "load":    { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Transaction checks and account loading" },
                "execute": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Transaction execution, including VM setup" },
                "commit":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Transaction result commit" }
            }
        },
        "vm_regime_duration_nanos": {
            "type": "Tuple",
            "description": "Time in top-level BPF invocations, by phase, with CPI setup and commit split out; nested programs, including native CPIs, count as Interpreter; subset of TxnRegime Execute",
            "aliases": {
                "all": ["setup", "commit", "setup_cpi", "commit_cpi", "interpreter"],
                "cpi": ["setup_cpi", "commit_cpi"]
            },
            "fields": {
                "setup":       { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "VM setup" },
                "commit":      { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "VM commit" },
                "setup_cpi":   { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "VM setup (CPI)" },
                "commit_cpi":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "VM commit (CPI)" },
                "interpreter": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "VM interpreter execution" }
            }
        },
        "progcache_looked_up":           { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "Program cache lookups; equals Hit + Miss + lookups of invalid program accounts" },
        "progcache_miss":                { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "Program cache misses, each followed by an insert or a spill" },
        "progcache_waited":              { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "Program cache lookups that waited on another tile's in-flight load of the same program" },
        "progcache_insert_retried":      { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "Program cache inserts that found no free slot in their size class on the first try and retried after eviction" },
        "progcache_inserted_bytes":      { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "Bytes inserted into the program cache" },
        "progcache_spilled_bytes":       { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "Bytes loaded into program cache spill memory" },
        "progcache_evicted_bytes":       { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "Bytes evicted from the program cache by insert eviction sweeps" },
        "progcache_duration_nanos":      { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "Time in program cache lookups, including waits on peer loads and insert, eviction and ELF load on a miss; superset of ProgcacheLoadDurationNanos" },
        "progcache_loaded":              { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "Program ELF loads and verifications for the program cache, including failed verifications and spill-backed loads" },
        "progcache_load_duration_nanos": { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "Time spent loading programs" },
        "progcache_hit": {
            "type": "Tuple",
            "description": "Program cache hits, by size class",
            "aliases": {
                "all": ["le128_kib", "le512_kib", "le1_mib", "le2_mib", "le4_mib", "le11_mib"]
            },
            "fields": {
                "le128_kib": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "0-128 KiB" },
                "le512_kib": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "128-512 KiB" },
                "le1_mib":   { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "512 KiB-1 MiB" },
                "le2_mib":   { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "1-2 MiB" },
                "le4_mib":   { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "2-4 MiB" },
                "le11_mib":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "4-11 MiB" }
            }
        },
        "progcache_inserted": {
            "type": "Tuple",
            "description": "Programs inserted into the program cache, by size class",
            "aliases": {
                "all": ["le128_kib", "le512_kib", "le1_mib", "le2_mib", "le4_mib", "le11_mib"]
            },
            "fields": {
                "le128_kib": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "0-128 KiB" },
                "le512_kib": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "128-512 KiB" },
                "le1_mib":   { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "512 KiB-1 MiB" },
                "le2_mib":   { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "1-2 MiB" },
                "le4_mib":   { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "2-4 MiB" },
                "le11_mib":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "4-11 MiB" }
            }
        },
        "progcache_evicted": {
            "type": "Tuple",
            "description": "Program cache slots reclaimed by an insert's eviction sweep, by size class (housekeeping preevicts are counted by the accdb tile)",
            "aliases": {
                "all": ["le128_kib", "le512_kib", "le1_mib", "le2_mib", "le4_mib", "le11_mib"]
            },
            "fields": {
                "le128_kib": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "0-128 KiB" },
                "le512_kib": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "128-512 KiB" },
                "le1_mib":   { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "512 KiB-1 MiB" },
                "le2_mib":   { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "1-2 MiB" },
                "le4_mib":   { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "2-4 MiB" },
                "le11_mib":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "4-11 MiB" }
            }
        },
        "progcache_spilled": {
            "type": "Tuple",
            "description": "Programs loaded into spill memory because no cache slot could be freed, by size class",
            "aliases": {
                "all": ["le128_kib", "le512_kib", "le1_mib", "le2_mib", "le4_mib", "le11_mib"]
            },
            "fields": {
                "le128_kib": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "0-128 KiB" },
                "le512_kib": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "128-512 KiB" },
                "le1_mib":   { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "512 KiB-1 MiB" },
                "le2_mib":   { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "1-2 MiB" },
                "le4_mib":   { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "2-4 MiB" },
                "le11_mib":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "4-11 MiB" }
            }
        },
        "accdb_account_readonly_acquired": {
            "type": "Tuple",
            "description": "Readonly accounts acquired from the account database, by cache size class of the account's current data size",
            "aliases": {
                "all": ["le128_b", "le512_b", "le2_kib", "le8_kib", "le32_kib", "le128_kib", "le1_mib", "le10_mib"]
            },
            "fields": {
                "le128_b":   { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "0-128 B" },
                "le512_b":   { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "129-512 B" },
                "le2_kib":   { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "513 B-2 KiB" },
                "le8_kib":   { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "2-8 KiB" },
                "le32_kib":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "8-32 KiB" },
                "le128_kib": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "32-128 KiB" },
                "le1_mib":   { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "128 KiB-1 MiB" },
                "le10_mib":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "1-10 MiB" }
            }
        },
        "accdb_account_writable_acquired": {
            "type": "Tuple",
            "description": "Writable accounts acquired from the account database, by cache size class of the account's current data size",
            "aliases": {
                "all": ["le128_b", "le512_b", "le2_kib", "le8_kib", "le32_kib", "le128_kib", "le1_mib", "le10_mib"]
