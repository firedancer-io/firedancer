{
    "name": "metrics_snapin",
    "id": 44,
    "description": "Metrics of one snapin tile instance, one row per sweep",
    "local": true,
    "fields": {
        "sample_id":                  { "type": "UInt64",                                                         "description": "Identifier shared by every row of one sweep" },
        "sample_reason":              { "type": "ref:MetricsSampleReason",                                        "description": "Why the sweep was taken" },
        "sample_slot":                { "type": "UInt64",                                                         "description": "Slot that triggered the sweep, 0 for periodic sweeps" },
        "sample_snapct_state":        { "type": "ref:MetricsSnapctLoadState",                                     "description": "Snapshot load state entered, for snapct_state sweeps; unknown otherwise" },
        "sample_caught_up":           { "type": "Bool",                                                           "description": "Whether replay had caught up to the cluster tip when the sweep was taken (replay IsCaughtUp); set once per run, never cleared" },
        "sample_tile_cnt":            { "type": "UInt64",                                                         "description": "Tile instances in the sweep, to detect partial sweeps" },
        "kind_id":                    { "type": "UInt64",                                                         "description": "Index of this tile instance among tiles of its kind" },
        "pid":                        { "type": "UInt64",                     "compression": "T64, ZSTD",         "description": "Process ID of the tile" },
        "tid":                        { "type": "UInt64",                     "compression": "T64, ZSTD",         "description": "Thread ID of the tile. Same as Pid in production, but might differ in development" },
        "last_cpu_index":             { "type": "UInt64",                     "compression": "T64, ZSTD",         "description": "CPU the tile last ran on" },
        "context_switch_involuntary": { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "counter: cumulative since tile start, query deltas. Involuntary context switches" },
        "context_switch_voluntary":   { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "counter: cumulative since tile start, query deltas. Voluntary context switches" },
        "page_fault_major":           { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "counter: cumulative since tile start, query deltas. Major page faults" },
        "page_fault_minor":           { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "counter: cumulative since tile start, query deltas. Minor page faults" },
        "state": {
            "type": "LowCardinality(String)",
            "description": "Tile lifecycle state: 0=booting, 1=running, 2=shutdown",
            "variants": {
                "booting":  { "description": "Booting" },
                "running":  { "description": "Running" },
                "shutdown": { "description": "Shutdown" }
            }
        },
        "heartbeat_time":             { "type": "DateTime64(9)",              "compression": "Delta, ZSTD",       "description": "Last wall-clock time the tile heartbeated" },
        "is_backpressured":           { "type": "Bool",                                                           "description": "Whether the tile is currently backpressured" },
        "backpressure":               { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "counter: cumulative since tile start, query deltas. Times the tile waited for one or more consumers to catch up to resume publishing" },
        "regime_duration_nanos": {
            "type": "Tuple",
            "description": "Tile wall time, by regime; regimes are exhaustive and groups Busy, Idle, Backpressure and Housekeeping partition it",
            "aliases": {
                "all":          ["caught_up_housekeeping", "processing_housekeeping", "backpressure_housekeeping", "caught_up_prefrag", "processing_prefrag", "backpressure_prefrag", "caught_up_postfrag", "processing_postfrag", "caught_up_sleeping", "backpressure_sleeping"],
                "housekeeping": ["caught_up_housekeeping", "processing_housekeeping", "backpressure_housekeeping"],
                "busy":         ["caught_up_prefrag", "processing_prefrag", "processing_postfrag"],
                "idle":         ["caught_up_postfrag", "caught_up_sleeping"],
                "backpressure": ["backpressure_prefrag", "backpressure_sleeping"],
                "sleeping":     ["caught_up_sleeping", "backpressure_sleeping"]
            },
            "fields": {
                "caught_up_housekeeping":    { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Caught up + Housekeeping" },
                "processing_housekeeping":   { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Processing + Housekeeping" },
                "backpressure_housekeeping": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Backpressure + Housekeeping" },
                "caught_up_prefrag":         { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Caught up + Prefrag" },
                "processing_prefrag":        { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Processing + Prefrag" },
                "backpressure_prefrag":      { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Backpressure + Prefrag" },
                "caught_up_postfrag":        { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Caught up + Postfrag" },
                "processing_postfrag":       { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Processing + Postfrag" },
                "caught_up_sleeping":        { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Caught up + Sleeping" },
                "backpressure_sleeping":     { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Backpressure + Sleeping" }
            }
        },
        "thread_duration_nanos": {
            "type": "Tuple",
            "description": "Thread wall time since start, by scheduler state; Idle is the remainder, so parts sum to about the lifetime.  User, System and Interrupt have 10 ms resolution; Interrupt is 0 unless it is the only live tile pinned to its CPU",
            "aliases": {
                "all":       ["wait", "idle", "user", "system", "interrupt"],
                "running":   ["user", "system"],
                "preempted": ["wait", "interrupt"]
            },
            "fields": {
                "wait":      { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Wait (task was runnable but not scheduled)" },
                "idle":      { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Idle (task was not runnable)" },
                "user":      { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "User (task was scheduled and executing in user mode)" },
                "system":    { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "System (task was scheduled and executing in kernel mode)" },
                "interrupt": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Interrupt (CPU time stolen by hardirq/softirq handlers or a hypervisor; fixed tiles only)" }
            }
        },
        "park_attempted": {
            "type": "Tuple",
            "description": "Times the tile tried to park while idle (efficient mode), by result",
            "aliases": {
                "all": ["ring", "deadline", "pending"]
            },
            "fields": {
                "ring":     { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Woken by a doorbell ring" },
                "deadline": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Deadline or park cap lapsed" },
                "pending":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Pre-park recheck found work, did not park" }
            }
        },
        "device_irq":                 { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "counter: cumulative since tile start, query deltas. Device IRQs on the tile's dedicated CPU, 0 unless it is the only live tile pinned there" },
        "tlb_shootdown":              { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "counter: cumulative since tile start, query deltas. TLB shootdowns on the tile's dedicated CPU, 0 unless it is the only live tile pinned there" },
        "timer_irq":                  { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "counter: cumulative since tile start, query deltas. Local timer interrupts (LOC) on the tile's dedicated CPU, 0 unless it is the only live tile pinned there" },
        "stream_state": {
            "type": "LowCardinality(String)",
            "description": "Snapshot inserter state: 0=idle, 1=processing, 2=finishing, 3=error, 4=shutdown",
            "variants": {
                "idle":       { "description": "Idle" },
                "processing": { "description": "Processing" },
                "finishing":  { "description": "Finishing" },
                "error":      { "description": "Error" },
                "shutdown":   { "description": "Shutdown" }
            }
        },
        "parse_progress_bytes": {
            "type": "Tuple",
            "description": "Decompressed bytes of each snapshot this tile parsed in the current attempt; every snapin tile parses the whole stream, so take the min across tiles",
            "fields": {
                "full":        { "type": "UInt64", "compression": "T64, ZSTD", "description": "Full snapshot" },
                "incremental": { "type": "UInt64", "compression": "T64, ZSTD", "description": "Incremental snapshot" }
            }
        },
        "disk_written_bytes":         { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "Bytes this tile has written to the accounts database file" },
        "account_progress": {
            "type": "Tuple",
            "description": "Accounts this tile processed in the current load, by result (Ignored accounts are not inserted); sum across tiles, rewinds on retry",
            "fields": {
                "new":      { "type": "UInt64", "compression": "T64, ZSTD", "description": "New account inserted" },
                "replaced": { "type": "UInt64", "compression": "T64, ZSTD", "description": "Replaced an older duplicate inserted earlier" },
                "ignored":  { "type": "UInt64", "compression": "T64, ZSTD", "description": "Dropped because an inserted duplicate was newer" }
            }
        },
        "account_processed":          { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "Accounts processed across all snapshots" },
        "account_batch_processed":    { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "Account batches processed across all snapshots" },
        "flush_regime_duration_nanos": {
            "type": "Tuple",
            "description": "Time this tile spent flushing the account write buffer, by phase; subset of the tile's Busy regime",
            "aliases": {
                "all": ["disk_reserve", "disk_write", "index_insert", "stake_delegation"]
            },
            "fields": {
                "disk_reserve":     { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Reserving space in the accounts database file, including partition growth" },
                "disk_write":       { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Writing the account write buffer to the accounts database file" },
                "index_insert":     { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Inserting written accounts into the accounts database index" },
                "stake_delegation": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Updating stake delegations for stake and replaced accounts" }
            }
        },
        "disk_write_duration_nanos": {
            "type": "Tuple",
            "description": "Duration of one write of the account write buffer to the accounts database file",
            "fields": {
                "b0":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[0, 1000000) nanos" },
                "b1":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[1000000, 1637894) nanos" },
                "b2":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[1637894, 2682696) nanos" },
                "b3":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[2682696, 4393971) nanos" },
                "b4":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[4393971, 7196857) nanos" },
                "b5":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[7196857, 11787687) nanos" },
                "b6":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[11787687, 19306978) nanos" },
                "b7":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[19306978, 31622778) nanos" },
                "b8":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[31622778, 51794749) nanos" },
                "b9":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[51794749, 84834293) nanos" },
                "b10": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[84834293, 138949554) nanos" },
                "b11": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[138949554, 227584598) nanos" },
                "b12": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[227584598, 372759378) nanos" },
                "b13": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[372759378, 610540235) nanos" },
                "b14": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[610540235, 1000000000) nanos" },
                "b15": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[1000000000, inf) nanos" },
                "sum": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Sum of samples (nanos)" }
            }
        }
    }
}
