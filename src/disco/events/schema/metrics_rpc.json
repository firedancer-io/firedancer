{
    "name": "metrics_rpc",
    "id": 46,
    "description": "Metrics of one rpc tile instance, one row per sweep",
    "local": true,
    "fields": {
        "sample_id":                  { "type": "UInt64",                                                         "description": "Identifier shared by every row of one sweep" },
        "sample_reason":              { "type": "ref:MetricsSampleReason",                                        "description": "Why the sweep was taken" },
        "sample_slot":                { "type": "UInt64",                                                         "description": "Slot that triggered the sweep, 0 for periodic sweeps" },
        "sample_snapct_state":        { "type": "ref:MetricsSnapctLoadState",                                     "description": "Snapshot load state entered, for snapct_state sweeps; unknown otherwise" },
        "sample_caught_up":           { "type": "Bool",                                                           "description": "Whether replay had caught up to the cluster tip when the sweep was taken (replay IsCaughtUp); set once per run, never cleared" },
        "sample_tile_cnt":            { "type": "UInt64",                                                         "description": "Tile instances in the sweep, to detect partial sweeps" },
        "kind_id":                    { "type": "UInt64",                                                         "description": "Index of this tile instance among tiles of its kind" },
        "pid":                        { "type": "UInt64",                     "compression": "T64, ZSTD",         "description": "Process ID of the tile" },
        "tid":                        { "type": "UInt64",                     "compression": "T64, ZSTD",         "description": "Thread ID of the tile. Same as Pid in production, but might differ in development" },
        "last_cpu_index":             { "type": "UInt64",                     "compression": "T64, ZSTD",         "description": "CPU the tile last ran on" },
        "context_switch_involuntary": { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "counter: cumulative since tile start, query deltas. Involuntary context switches" },
        "context_switch_voluntary":   { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "counter: cumulative since tile start, query deltas. Voluntary context switches" },
        "page_fault_major":           { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "counter: cumulative since tile start, query deltas. Major page faults" },
        "page_fault_minor":           { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "counter: cumulative since tile start, query deltas. Minor page faults" },
        "state": {
            "type": "LowCardinality(String)",
            "description": "Tile lifecycle state: 0=booting, 1=running, 2=shutdown",
            "variants": {
                "booting":  { "description": "Booting" },
                "running":  { "description": "Running" },
                "shutdown": { "description": "Shutdown" }
            }
        },
        "heartbeat_time":             { "type": "DateTime64(9)",              "compression": "Delta, ZSTD",       "description": "Last wall-clock time the tile heartbeated" },
        "is_backpressured":           { "type": "Bool",                                                           "description": "Whether the tile is currently backpressured" },
        "backpressure":               { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "counter: cumulative since tile start, query deltas. Times the tile waited for one or more consumers to catch up to resume publishing" },
        "regime_duration_nanos": {
            "type": "Tuple",
            "description": "Tile wall time, by regime; regimes are exhaustive and groups Busy, Idle, Backpressure and Housekeeping partition it",
            "aliases": {
                "all":          ["caught_up_housekeeping", "processing_housekeeping", "backpressure_housekeeping", "caught_up_prefrag", "processing_prefrag", "backpressure_prefrag", "caught_up_postfrag", "processing_postfrag", "caught_up_sleeping", "backpressure_sleeping"],
                "housekeeping": ["caught_up_housekeeping", "processing_housekeeping", "backpressure_housekeeping"],
                "busy":         ["caught_up_prefrag", "processing_prefrag", "processing_postfrag"],
                "idle":         ["caught_up_postfrag", "caught_up_sleeping"],
                "backpressure": ["backpressure_prefrag", "backpressure_sleeping"],
                "sleeping":     ["caught_up_sleeping", "backpressure_sleeping"]
            },
            "fields": {
                "caught_up_housekeeping":    { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Caught up + Housekeeping" },
                "processing_housekeeping":   { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Processing + Housekeeping" },
                "backpressure_housekeeping": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Backpressure + Housekeeping" },
                "caught_up_prefrag":         { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Caught up + Prefrag" },
                "processing_prefrag":        { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Processing + Prefrag" },
                "backpressure_prefrag":      { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Backpressure + Prefrag" },
                "caught_up_postfrag":        { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Caught up + Postfrag" },
                "processing_postfrag":       { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Processing + Postfrag" },
                "caught_up_sleeping":        { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Caught up + Sleeping" },
                "backpressure_sleeping":     { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Backpressure + Sleeping" }
            }
        },
        "thread_duration_nanos": {
            "type": "Tuple",
            "description": "Thread wall time since start, by scheduler state; Idle is the remainder, so parts sum to about the lifetime.  User, System and Interrupt have 10 ms resolution; Interrupt is 0 unless it is the only live tile pinned to its CPU",
            "aliases": {
                "all":       ["wait", "idle", "user", "system", "interrupt"],
                "running":   ["user", "system"],
                "preempted": ["wait", "interrupt"]
            },
            "fields": {
                "wait":      { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Wait (task was runnable but not scheduled)" },
                "idle":      { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Idle (task was not runnable)" },
                "user":      { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "User (task was scheduled and executing in user mode)" },
                "system":    { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "System (task was scheduled and executing in kernel mode)" },
                "interrupt": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Interrupt (CPU time stolen by hardirq/softirq handlers or a hypervisor; fixed tiles only)" }
            }
        },
        "park_attempted": {
            "type": "Tuple",
            "description": "Times the tile tried to park while idle (efficient mode), by result",
            "aliases": {
                "all": ["ring", "deadline", "pending"]
            },
            "fields": {
                "ring":     { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Woken by a doorbell ring" },
                "deadline": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Deadline or park cap lapsed" },
                "pending":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Pre-park recheck found work, did not park" }
            }
        },
        "device_irq":                 { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "counter: cumulative since tile start, query deltas. Device IRQs on the tile's dedicated CPU, 0 unless it is the only live tile pinned there" },
        "tlb_shootdown":              { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "counter: cumulative since tile start, query deltas. TLB shootdowns on the tile's dedicated CPU, 0 unless it is the only live tile pinned there" },
        "timer_irq":                  { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "counter: cumulative since tile start, query deltas. Local timer interrupts (LOC) on the tile's dedicated CPU, 0 unless it is the only live tile pinned there" },
        "request_duration_nanos": {
            "type": "Tuple",
            "description": "Time to handle one HTTP request or WebSocket message, excluding socket I/O",
            "fields": {
                "b0":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[0, 1000) nanos" },
                "b1":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[1000, 2276) nanos" },
                "b2":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[2276, 5180) nanos" },
                "b3":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[5180, 11789) nanos" },
                "b4":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[11789, 26830) nanos" },
                "b5":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[26830, 61060) nanos" },
                "b6":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[61060, 138962) nanos" },
                "b7":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[138962, 316253) nanos" },
                "b8":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[316253, 719735) nanos" },
                "b9":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[719735, 1637987) nanos" },
                "b10": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[1637987, 3727764) nanos" },
                "b11": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[3727764, 8483720) nanos" },
                "b12": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[8483720, 19307419) nanos" },
                "b13": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[19307419, 43940208) nanos" },
                "b14": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[43940208, 100000000) nanos" },
                "b15": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[100000000, inf) nanos" },
                "sum": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Sum of samples (nanos)" }
            }
        },
        "request_handled": {
            "type": "Tuple",
            "description": "RPC requests handled, by method, before parameter validation",
            "aliases": {
                "all": ["genesis", "unknown", "get_account_info", "get_balance", "get_block_height", "get_cluster_nodes", "get_epoch_info", "get_genesis_hash", "get_health", "get_identity", "get_inflation_governor", "get_latest_blockhash", "get_minimum_balance_for_rent_exemption", "get_multiple_accounts", "get_slot", "get_transaction_count", "get_version", "get_max_retransmit_slot", "get_slot_leader", "get_slot_leaders", "get_leader_schedule", "get_ag_genesis_cert", "slot_subscribe", "slot_unsubscribe", "vote_subscribe", "vote_unsubscribe", "unimplemented", "invalid", "health"]
            },
            "fields": {
                "genesis":                                { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "GET /genesis.tar.bz2" },
                "unknown":                                { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Unknown method" },
                "get_account_info":                       { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "getAccountInfo" },
                "get_balance":                            { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "getBalance" },
                "get_block_height":                       { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "getBlockHeight" },
                "get_cluster_nodes":                      { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "getClusterNodes" },
                "get_epoch_info":                         { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "getEpochInfo" },
                "get_genesis_hash":                       { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "getGenesisHash" },
                "get_health":                             { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "getHealth" },
                "get_identity":                           { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "getIdentity" },
                "get_inflation_governor":                 { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "getInflationGovernor" },
                "get_latest_blockhash":                   { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "getLatestBlockhash" },
                "get_minimum_balance_for_rent_exemption": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "getMinimumBalanceForRentExemption" },
                "get_multiple_accounts":                  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "getMultipleAccounts" },
                "get_slot":                               { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "getSlot" },
                "get_transaction_count":                  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "getTransactionCount" },
                "get_version":                            { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "getVersion" },
                "get_max_retransmit_slot":                { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "getMaxRetransmitSlot" },
                "get_slot_leader":                        { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "getSlotLeader" },
                "get_slot_leaders":                       { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "getSlotLeaders" },
                "get_leader_schedule":                    { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "getLeaderSchedule" },
                "get_ag_genesis_cert":                    { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "getAgGenesisCert" },
                "slot_subscribe":                         { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "slotSubscribe" },
                "slot_unsubscribe":                       { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "slotUnsubscribe" },
                "vote_subscribe":                         { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "voteSubscribe" },
                "vote_unsubscribe":                       { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "voteUnsubscribe" },
                "unimplemented":                          { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Known method not implemented by Firedancer" },
                "invalid":                                { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Malformed JSON-RPC request" },
                "health":                                 { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "GET /health" }
            }
        },
        "conn_open":                  { "type": "UInt64",                     "compression": "T64, ZSTD",         "description": "Open HTTP connections to the RPC service" },
        "websocket_conn_open":        { "type": "UInt64",                     "compression": "T64, ZSTD",         "description": "Open WebSocket connections to the RPC service" },
        "websocket_subscriber_count": {
            "type": "Tuple",
            "description": "WebSocket connections subscribed to each notification type",
            "fields": {
                "vote": { "type": "UInt64", "compression": "T64, ZSTD", "description": "vote" },
                "slot": { "type": "UInt64", "compression": "T64, ZSTD", "description": "slot" }
            }
        },
        "websocket_notification_published": {
            "type": "Tuple",
            "description": "Notifications published to at least one subscriber, by notification type",
            "aliases": {
                "all": ["vote", "slot"]
            },
            "fields": {
                "vote": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "vote" },
                "slot": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "slot" }
            }
        },
        "websocket_notification_tx": {
            "type": "Tuple",
            "description": "Notifications sent, counting each subscriber, by notification type",
            "aliases": {
                "all": ["vote", "slot"]
            },
            "fields": {
                "vote": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "vote" },
                "slot": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "slot" }
            }
        },
        "accdb_account_readonly_acquired": {
            "type": "Tuple",
            "description": "Readonly accounts acquired from the account database, by cache size class of the account's current data size",
            "aliases": {
                "all": ["le128_b", "le512_b", "le2_kib", "le8_kib", "le32_kib", "le128_kib", "le1_mib", "le10_mib"]
            },
            "fields": {
                "le128_b":   { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "0-128 B" },
                "le512_b":   { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "129-512 B" },
                "le2_kib":   { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "513 B-2 KiB" },
                "le8_kib":   { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "2-8 KiB" },
                "le32_kib":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "8-32 KiB" },
                "le128_kib": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "32-128 KiB" },
                "le1_mib":   { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "128 KiB-1 MiB" },
                "le10_mib":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "1-10 MiB" }
            }
        },
        "accdb_account_cache_missed": {
            "type": "Tuple",
            "description": "Accounts not found in the account database cache and read from disk, by cache size class",
            "aliases": {
                "all": ["le128_b", "le512_b", "le2_kib", "le8_kib", "le32_kib", "le128_kib", "le1_mib", "le10_mib"]
            },
            "fields": {
                "le128_b":   { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "0-128 B" },
                "le512_b":   { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "129-512 B" },
                "le2_kib":   { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "513 B-2 KiB" },
                "le8_kib":   { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "2-8 KiB" },
                "le32_kib":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "8-32 KiB" },
                "le128_kib": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "32-128 KiB" },
                "le1_mib":   { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "128 KiB-1 MiB" },
                "le10_mib":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "1-10 MiB" }
            }
        },
        "accdb_account_waited":       { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "Accounts that had to wait for another reader to finish loading them into the cache" },
        "accdb_disk_read_bytes":      { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "Bytes read from the account database file" },
        "accdb_disk_read":            { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "Reads from the account database file" },
        "accdb_copied_bytes":         { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "Account data bytes copied in memory between cache lines, staging buffers and callers; disk reads excluded" }
    }
}
