{
    "name": "metrics_quic",
    "id": 25,
    "description": "Metrics of one quic tile instance, one row per sweep",
    "local": true,
    "fields": {
        "sample_id":                        { "type": "UInt64",                                                         "description": "Identifier shared by every row of one sweep" },
        "sample_reason":                    { "type": "ref:MetricsSampleReason",                                        "description": "Why the sweep was taken" },
        "sample_slot":                      { "type": "UInt64",                                                         "description": "Slot that triggered the sweep, 0 for periodic sweeps" },
        "sample_snapct_state":              { "type": "ref:MetricsSnapctLoadState",                                     "description": "Snapshot load state entered, for snapct_state sweeps; unknown otherwise" },
        "sample_caught_up":                 { "type": "Bool",                                                           "description": "Whether replay had caught up to the cluster tip when the sweep was taken (replay IsCaughtUp); set once per run, never cleared" },
        "sample_tile_cnt":                  { "type": "UInt64",                                                         "description": "Tile instances in the sweep, to detect partial sweeps" },
        "kind_id":                          { "type": "UInt64",                                                         "description": "Index of this tile instance among tiles of its kind" },
        "pid":                              { "type": "UInt64",                     "compression": "T64, ZSTD",         "description": "Process ID of the tile" },
        "tid":                              { "type": "UInt64",                     "compression": "T64, ZSTD",         "description": "Thread ID of the tile. Same as Pid in production, but might differ in development" },
        "last_cpu_index":                   { "type": "UInt64",                     "compression": "T64, ZSTD",         "description": "CPU the tile last ran on" },
        "context_switch_involuntary":       { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "counter: cumulative since tile start, query deltas. Involuntary context switches" },
        "context_switch_voluntary":         { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "counter: cumulative since tile start, query deltas. Voluntary context switches" },
        "page_fault_major":                 { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "counter: cumulative since tile start, query deltas. Major page faults" },
        "page_fault_minor":                 { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "counter: cumulative since tile start, query deltas. Minor page faults" },
        "state": {
            "type": "LowCardinality(String)",
            "description": "Tile lifecycle state: 0=booting, 1=running, 2=shutdown",
            "variants": {
                "booting":  { "description": "Booting" },
                "running":  { "description": "Running" },
                "shutdown": { "description": "Shutdown" }
            }
        },
        "heartbeat_time":                   { "type": "DateTime64(9)",              "compression": "Delta, ZSTD",       "description": "Last wall-clock time the tile heartbeated" },
        "is_backpressured":                 { "type": "Bool",                                                           "description": "Whether the tile is currently backpressured" },
        "backpressure":                     { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "counter: cumulative since tile start, query deltas. Times the tile waited for one or more consumers to catch up to resume publishing" },
        "regime_duration_nanos": {
            "type": "Tuple",
            "description": "Tile wall time, by regime; regimes are exhaustive and groups Busy, Idle, Backpressure and Housekeeping partition it",
            "aliases": {
                "all":          ["caught_up_housekeeping", "processing_housekeeping", "backpressure_housekeeping", "caught_up_prefrag", "processing_prefrag", "backpressure_prefrag", "caught_up_postfrag", "processing_postfrag", "caught_up_sleeping", "backpressure_sleeping"],
                "housekeeping": ["caught_up_housekeeping", "processing_housekeeping", "backpressure_housekeeping"],
                "busy":         ["caught_up_prefrag", "processing_prefrag", "processing_postfrag"],
                "idle":         ["caught_up_postfrag", "caught_up_sleeping"],
                "backpressure": ["backpressure_prefrag", "backpressure_sleeping"],
                "sleeping":     ["caught_up_sleeping", "backpressure_sleeping"]
            },
            "fields": {
                "caught_up_housekeeping":    { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Caught up + Housekeeping" },
                "processing_housekeeping":   { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Processing + Housekeeping" },
                "backpressure_housekeeping": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Backpressure + Housekeeping" },
                "caught_up_prefrag":         { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Caught up + Prefrag" },
                "processing_prefrag":        { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Processing + Prefrag" },
                "backpressure_prefrag":      { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Backpressure + Prefrag" },
                "caught_up_postfrag":        { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Caught up + Postfrag" },
                "processing_postfrag":       { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Processing + Postfrag" },
                "caught_up_sleeping":        { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Caught up + Sleeping" },
                "backpressure_sleeping":     { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Backpressure + Sleeping" }
            }
        },
        "thread_duration_nanos": {
            "type": "Tuple",
            "description": "Thread wall time since start, by scheduler state; Idle is the remainder, so parts sum to about the lifetime.  User, System and Interrupt have 10 ms resolution; Interrupt is 0 unless it is the only live tile pinned to its CPU",
            "aliases": {
                "all":       ["wait", "idle", "user", "system", "interrupt"],
                "running":   ["user", "system"],
                "preempted": ["wait", "interrupt"]
            },
            "fields": {
                "wait":      { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Wait (task was runnable but not scheduled)" },
                "idle":      { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Idle (task was not runnable)" },
                "user":      { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "User (task was scheduled and executing in user mode)" },
                "system":    { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "System (task was scheduled and executing in kernel mode)" },
                "interrupt": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Interrupt (CPU time stolen by hardirq/softirq handlers or a hypervisor; fixed tiles only)" }
            }
        },
        "park_attempted": {
            "type": "Tuple",
            "description": "Times the tile tried to park while idle (efficient mode), by result",
            "aliases": {
                "all": ["ring", "deadline", "pending"]
            },
            "fields": {
                "ring":     { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Woken by a doorbell ring" },
                "deadline": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Deadline or park cap lapsed" },
                "pending":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Pre-park recheck found work, did not park" }
            }
        },
        "device_irq":                       { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "counter: cumulative since tile start, query deltas. Device IRQs on the tile's dedicated CPU, 0 unless it is the only live tile pinned there" },
        "tlb_shootdown":                    { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "counter: cumulative since tile start, query deltas. TLB shootdowns on the tile's dedicated CPU, 0 unless it is the only live tile pinned there" },
        "timer_irq":                        { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "counter: cumulative since tile start, query deltas. Local timer interrupts (LOC) on the tile's dedicated CPU, 0 unless it is the only live tile pinned there" },
        "txn_reassembly_evicted":           { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "Txns evicted from reassembly before completing (txn_reassembly_count too small)" },
        "txn_reassembly_started":           { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "Fragmented txn receive ops started" },
        "txn_reassembly_pending":           { "type": "UInt64",                     "compression": "T64, ZSTD",         "description": "Fragmented txn reassemblies in progress" },
        "txn_reassembly_chunk_rx":          { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "Txn stream chunks received for reassembly" },
        "txn_reassembly_gap_dropped":       { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "Txn stream chunks dropped because of a data gap" },
        "txn_reassembly_duplicate_dropped": { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "Txn stream chunks dropped as duplicates of a completed stream" },
        "txn_rx": {
            "type": "Tuple",
            "description": "Transactions published to verify, by TPU ingress path; excludes all *Dropped",
            "aliases": {
                "all": ["udp", "quic_fast", "quic_frag"]
            },
            "fields": {
                "udp":       { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "TPU/UDP" },
                "quic_fast": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "TPU/QUIC unfragmented" },
                "quic_frag": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "TPU/QUIC fragmented" }
            }
        },
        "txn_reassembly_abandoned":         { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "Txn reassemblies abandoned because the connection was lost" },
        "txn_undersize_dropped":            { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "Txns received via QUIC dropped because they were too small" },
        "txn_oversize_dropped":             { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "Txns received via QUIC dropped because they were too large" },
        "udp_txn_undersize_dropped":        { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "Packets received on the non-QUIC port that were too small to be a valid IP packet" },
        "udp_txn_oversize_dropped":         { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "Packets received on the non-QUIC port that were too large to be a valid transaction" },
        "pkt_rx":                           { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "UDP datagrams received (one may carry several coalesced QUIC packets)" },
        "pkt_rx_bytes":                     { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "Bytes of UDP datagrams received, including Ethernet, IPv4 and UDP headers" },
        "pkt_tx":                           { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "UDP datagrams sent" },
        "pkt_tx_bytes":                     { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "Bytes of UDP datagrams sent, including Ethernet, IPv4 and UDP headers" },
        "conn_used": {
            "type": "Tuple",
            "description": "Connection slots in use, by state; sum + ConnFree = ConnCapacity",
            "fields": {
                "handshake":          { "type": "UInt64", "compression": "T64, ZSTD", "description": "Handshaking peer" },
                "handshake_complete": { "type": "UInt64", "compression": "T64, ZSTD", "description": "Handshake complete, confirming with peer" },
                "active":             { "type": "UInt64", "compression": "T64, ZSTD", "description": "Active connection" },
                "peer_close":         { "type": "UInt64", "compression": "T64, ZSTD", "description": "Peer requested close" },
                "abort":              { "type": "UInt64", "compression": "T64, ZSTD", "description": "Connection terminating due to error" },
                "close_pending":      { "type": "UInt64", "compression": "T64, ZSTD", "description": "Connection is closing" },
                "dead":               { "type": "UInt64", "compression": "T64, ZSTD", "description": "Connection about to be freed" }
            }
        },
        "conn_free":                        { "type": "UInt64",                     "compression": "T64, ZSTD",         "description": "Connection slots free" },
        "conn_capacity":                    { "type": "UInt64",                     "compression": "T64, ZSTD",         "description": "Connection slots" },
        "conn_created":                     { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "Connections created" },
        "conn_closed":                      { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "Connections gracefully closed" },
        "conn_aborted":                     { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "Connections aborted" },
        "conn_timed_out":                   { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "Connections timed out" },
        "conn_retried":                     { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "Connections established with retry" },
        "conn_no_slot_rejected":            { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "Connections that failed to create due to lack of slots" },
        "conn_retry_rejected":              { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "Retries rejected: an invalid or expired token as server, a late or invalid Retry packet as client" },
        "pkt_dropped": {
            "type": "Tuple",
            "description": "Received packets dropped, by reason",
            "aliases": {
                "all": ["undersize", "oversize", "src_ip_mismatch", "header_invalid", "net_header_invalid", "version_unsupported", "duplicate"]
            },
            "fields": {
                "undersize":           { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "QUIC packet too small" },
                "oversize":            { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "QUIC packet too large" },
                "src_ip_mismatch":     { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Wrong source IP" },
                "header_invalid":      { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Invalid QUIC header" },
                "net_header_invalid":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Invalid IPv4 or UDP header" },
                "version_unsupported": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Version negotiation or unsupported version" },
                "duplicate":           { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Packet number already received or too old" }
            }
        },
        "pkt_no_conn_dropped": {
            "type": "Tuple",
            "description": "Packets with an unknown connection ID, by packet type",
            "aliases": {
                "all": ["initial", "retry", "handshake", "one_rtt"]
            },
            "fields": {
                "initial":   { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Initial" },
                "retry":     { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Retry" },
                "handshake": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Handshake" },
                "one_rtt":   { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "1-RTT" }
            }
        },
        "pkt_meta_acquire_attempted": {
            "type": "Tuple",
            "description": "Attempts to acquire packet metadata for transmission, by result",
            "aliases": {
                "all": ["success", "pool_empty", "conn_limit"]
            },
            "fields": {
                "success":    { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Success" },
                "pool_empty": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Packet metadata pool empty" },
                "conn_limit": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Connection reached its in-flight frame limit" }
            }
        },
        "initial_pkt_rx": {
            "type": "Tuple",
            "description": "Initial packets received, by token type",
            "aliases": {
                "all": ["none", "retry_token", "other"]
            },
            "fields": {
                "none":        { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "No token" },
                "retry_token": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "fd_quic retry token" },
                "other":       { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Token of another length" }
            }
        },
        "handshake_created":                { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "Handshake flows created" },
        "handshake_pool_full_rejected":     { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "Handshakes dropped due to alloc fail" },
        "handshake_evicted":                { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "Handshakes dropped due to eviction" },
        "stream_rx":                        { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "Stream receive events" },
        "stream_rx_bytes":                  { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "Stream payload bytes received" },
        "frame_rx": {
            "type": "Tuple",
            "description": "QUIC frames received, by frame type",
            "aliases": {
                "all": ["unknown", "ack", "reset_stream", "stop_sending", "crypto", "new_token", "stream", "max_data", "max_stream_data", "max_streams", "data_blocked", "stream_data_blocked", "streams_blocked", "new_conn_id", "retire_conn_id", "path_challenge", "path_response", "conn_close_quic", "conn_close_app", "handshake_done", "ping", "padding", "datagram"]
            },
            "fields": {
                "unknown":             { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Unknown frame type" },
                "ack":                 { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "ACK frame" },
                "reset_stream":        { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "RESET_STREAM frame" },
                "stop_sending":        { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "STOP_SENDING frame" },
                "crypto":              { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "CRYPTO frame" },
                "new_token":           { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "NEW_TOKEN frame" },
                "stream":              { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "STREAM frame" },
                "max_data":            { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "MAX_DATA frame" },
                "max_stream_data":     { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "MAX_STREAM_DATA frame" },
                "max_streams":         { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "MAX_STREAMS frame" },
                "data_blocked":        { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "DATA_BLOCKED frame" },
                "stream_data_blocked": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "STREAM_DATA_BLOCKED frame" },
                "streams_blocked":     { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "STREAMS_BLOCKED(bidi) frame" },
                "new_conn_id":         { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "NEW_CONN_ID frame" },
                "retire_conn_id":      { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "RETIRE_CONN_ID frame" },
                "path_challenge":      { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "PATH_CHALLENGE frame" },
                "path_response":       { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "PATH_RESPONSE frame" },
                "conn_close_quic":     { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "CONN_CLOSE(transport) frame" },
                "conn_close_app":      { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "CONN_CLOSE(app) frame" },
                "handshake_done":      { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "HANDSHAKE_DONE frame" },
                "ping":                { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "PING frame" },
                "padding":             { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "PADDING frame" },
                "datagram":            { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "DATAGRAM frame" }
            }
        },
        "pkt_ack_processed": {
            "type": "Tuple",
            "description": "Received packets processed for acknowledgement, by result",
            "aliases": {
                "all": ["no_pkt_number", "new_range", "merged", "queue_full", "cancelled"]
            },
            "fields": {
                "no_pkt_number": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Packet had no packet number to acknowledge" },
                "new_range":     { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "New ACK range" },
                "merged":        { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Merged into existing ACK range" },
                "queue_full":    { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Out of buffers" },
                "cancelled":     { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "ACK suppressed by handler" }
            }
        },
        "service_duration_nanos": {
            "type": "Tuple",
            "description": "Duration of one fd_quic_service call that processed a due connection timer",
            "fields": {
                "b0":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[0, 10) nanos" },
                "b1":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[10, 32) nanos" },
                "b2":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[32, 101) nanos" },
                "b3":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[101, 319) nanos" },
                "b4":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[319, 1008) nanos" },
                "b5":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[1008, 3185) nanos" },
                "b6":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[3185, 10064) nanos" },
                "b7":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[10064, 31800) nanos" },
                "b8":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[31800, 100480) nanos" },
                "b9":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[100480, 317492) nanos" },
                "b10": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[317492, 1003197) nanos" },
                "b11": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[1003197, 3169857) nanos" },
                "b12": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[3169857, 10015972) nanos" },
                "b13": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[10015972, 31648020) nanos" },
                "b14": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[31648020, 100000000) nanos" },
                "b15": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[100000000, inf) nanos" },
                "sum": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Sum of samples (nanos)" }
            }
        },
        "pkt_rx_duration_nanos": {
            "type": "Tuple",
            "description": "Duration of processing one received packet",
            "fields": {
                "b0":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[0, 10) nanos" },
                "b1":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[10, 32) nanos" },
                "b2":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[32, 101) nanos" },
                "b3":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[101, 319) nanos" },
                "b4":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[319, 1008) nanos" },
                "b5":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[1008, 3185) nanos" },
                "b6":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[3185, 10064) nanos" },
                "b7":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[10064, 31800) nanos" },
                "b8":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[31800, 100480) nanos" },
                "b9":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[100480, 317492) nanos" },
                "b10": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[317492, 1003197) nanos" },
                "b11": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[1003197, 3169857) nanos" },
                "b12": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[3169857, 10015972) nanos" },
                "b13": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[10015972, 31648020) nanos" },
                "b14": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[31648020, 100000000) nanos" },
