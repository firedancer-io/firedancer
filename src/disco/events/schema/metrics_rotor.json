{
    "name": "metrics_rotor",
    "id": 35,
    "description": "Metrics of one rotor tile instance, one row per sweep",
    "local": true,
    "fields": {
        "sample_id":                     { "type": "UInt64",                                                         "description": "Identifier shared by every row of one sweep" },
        "sample_reason":                 { "type": "ref:MetricsSampleReason",                                        "description": "Why the sweep was taken" },
        "sample_slot":                   { "type": "UInt64",                                                         "description": "Slot that triggered the sweep, 0 for periodic sweeps" },
        "sample_snapct_state":           { "type": "ref:MetricsSnapctLoadState",                                     "description": "Snapshot load state entered, for snapct_state sweeps; unknown otherwise" },
        "sample_caught_up":              { "type": "Bool",                                                           "description": "Whether replay had caught up to the cluster tip when the sweep was taken (replay IsCaughtUp); set once per run, never cleared" },
        "sample_tile_cnt":               { "type": "UInt64",                                                         "description": "Tile instances in the sweep, to detect partial sweeps" },
        "kind_id":                       { "type": "UInt64",                                                         "description": "Index of this tile instance among tiles of its kind" },
        "pid":                           { "type": "UInt64",                     "compression": "T64, ZSTD",         "description": "Process ID of the tile" },
        "tid":                           { "type": "UInt64",                     "compression": "T64, ZSTD",         "description": "Thread ID of the tile. Same as Pid in production, but might differ in development" },
        "last_cpu_index":                { "type": "UInt64",                     "compression": "T64, ZSTD",         "description": "CPU the tile last ran on" },
        "context_switch_involuntary":    { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "counter: cumulative since tile start, query deltas. Involuntary context switches" },
        "context_switch_voluntary":      { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "counter: cumulative since tile start, query deltas. Voluntary context switches" },
        "page_fault_major":              { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "counter: cumulative since tile start, query deltas. Major page faults" },
        "page_fault_minor":              { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "counter: cumulative since tile start, query deltas. Minor page faults" },
        "state": {
            "type": "LowCardinality(String)",
            "description": "Tile lifecycle state: 0=booting, 1=running, 2=shutdown",
            "variants": {
                "booting":  { "description": "Booting" },
                "running":  { "description": "Running" },
                "shutdown": { "description": "Shutdown" }
            }
        },
        "heartbeat_time":                { "type": "DateTime64(9)",              "compression": "Delta, ZSTD",       "description": "Last wall-clock time the tile heartbeated" },
        "is_backpressured":              { "type": "Bool",                                                           "description": "Whether the tile is currently backpressured" },
        "backpressure":                  { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "counter: cumulative since tile start, query deltas. Times the tile waited for one or more consumers to catch up to resume publishing" },
        "regime_duration_nanos": {
            "type": "Tuple",
            "description": "Tile wall time, by regime; regimes are exhaustive and groups Busy, Idle, Backpressure and Housekeeping partition it",
            "aliases": {
                "all":          ["caught_up_housekeeping", "processing_housekeeping", "backpressure_housekeeping", "caught_up_prefrag", "processing_prefrag", "backpressure_prefrag", "caught_up_postfrag", "processing_postfrag", "caught_up_sleeping", "backpressure_sleeping"],
                "housekeeping": ["caught_up_housekeeping", "processing_housekeeping", "backpressure_housekeeping"],
                "busy":         ["caught_up_prefrag", "processing_prefrag", "processing_postfrag"],
                "idle":         ["caught_up_postfrag", "caught_up_sleeping"],
                "backpressure": ["backpressure_prefrag", "backpressure_sleeping"],
                "sleeping":     ["caught_up_sleeping", "backpressure_sleeping"]
            },
            "fields": {
                "caught_up_housekeeping":    { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Caught up + Housekeeping" },
                "processing_housekeeping":   { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Processing + Housekeeping" },
                "backpressure_housekeeping": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Backpressure + Housekeeping" },
                "caught_up_prefrag":         { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Caught up + Prefrag" },
                "processing_prefrag":        { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Processing + Prefrag" },
                "backpressure_prefrag":      { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Backpressure + Prefrag" },
                "caught_up_postfrag":        { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Caught up + Postfrag" },
                "processing_postfrag":       { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Processing + Postfrag" },
                "caught_up_sleeping":        { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Caught up + Sleeping" },
                "backpressure_sleeping":     { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Backpressure + Sleeping" }
            }
        },
        "thread_duration_nanos": {
            "type": "Tuple",
            "description": "Thread wall time since start, by scheduler state; Idle is the remainder, so parts sum to about the lifetime.  User, System and Interrupt have 10 ms resolution; Interrupt is 0 unless it is the only live tile pinned to its CPU",
            "aliases": {
                "all":       ["wait", "idle", "user", "system", "interrupt"],
                "running":   ["user", "system"],
                "preempted": ["wait", "interrupt"]
            },
            "fields": {
                "wait":      { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Wait (task was runnable but not scheduled)" },
                "idle":      { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Idle (task was not runnable)" },
                "user":      { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "User (task was scheduled and executing in user mode)" },
                "system":    { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "System (task was scheduled and executing in kernel mode)" },
                "interrupt": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Interrupt (CPU time stolen by hardirq/softirq handlers or a hypervisor; fixed tiles only)" }
            }
        },
        "park_attempted": {
            "type": "Tuple",
            "description": "Times the tile tried to park while idle (efficient mode), by result",
            "aliases": {
                "all": ["ring", "deadline", "pending"]
            },
            "fields": {
                "ring":     { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Woken by a doorbell ring" },
                "deadline": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Deadline or park cap lapsed" },
                "pending":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Pre-park recheck found work, did not park" }
            }
        },
        "device_irq":                    { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "counter: cumulative since tile start, query deltas. Device IRQs on the tile's dedicated CPU, 0 unless it is the only live tile pinned there" },
        "tlb_shootdown":                 { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "counter: cumulative since tile start, query deltas. TLB shootdowns on the tile's dedicated CPU, 0 unless it is the only live tile pinned there" },
        "timer_irq":                     { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "counter: cumulative since tile start, query deltas. Local timer interrupts (LOC) on the tile's dedicated CPU, 0 unless it is the only live tile pinned there" },
        "pkt_tx":                        { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "Network packets sent, including requests, pings and pongs" },
        "request_tx": {
            "type": "Tuple",
            "description": "Signed repair messages queued, by type; window types send one per missing shred (up to 32), others one per attempt",
            "aliases": {
                "all": ["pong", "window_index", "highest_window_index", "orphan", "parent_fec_set_count", "fec_set_root", "window_index_for_block_id"]
            },
            "fields": {
                "pong":                      { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Pong" },
                "window_index":              { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Shred at an index" },
                "highest_window_index":      { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Highest shred at or above an index" },
                "orphan":                    { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Ancestors of an orphan slot" },
                "parent_fec_set_count":      { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Parent and FEC set count of a block (Alpenglow)" },
                "fec_set_root":              { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Merkle root of a FEC set (Alpenglow)" },
                "window_index_for_block_id": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Shred at an index of a specific block (Alpenglow)" }
            }
        },
        "highest_delivered_slot":        { "type": "UInt64",                     "compression": "T64, ZSTD",         "description": "Highest slot fully delivered to replay, 0 if none" },
        "highest_received_slot":         { "type": "UInt64",                     "compression": "T64, ZSTD",         "description": "Highest slot a shred was received for, 0 if none" },
        "first_turbine_slot":            { "type": "UInt64",                     "compression": "T64, ZSTD",         "description": "First turbine slot seen, the catchup target, 0 if none" },
        "block_pending":                 { "type": "UInt64",                     "compression": "T64, ZSTD",         "description": "Blocks in the eager, notar and final block treaps, waiting for discovery" },
        "request_in_flight":             { "type": "UInt64",                     "compression": "T64, ZSTD",         "description": "Pending request attempts awaiting a first response; a hedge is another attempt" },
        "fec_delivered":                 { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "FEC sets published to replay" },
        "shred_old_ignored":             { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "Shreds received at or below the root, ignored" },
        "shred_rx": {
            "type": "Tuple",
            "description": "Data shreds received as repair responses, by the pending request they matched",
            "aliases": {
                "all": ["for_block_id", "slot_index", "unmatched"]
            },
            "fields": {
                "for_block_id": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "First response to a WindowIndexForBlockId request" },
                "slot_index":   { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "First response to a WindowIndex or HighestWindowIndex request" },
                "unmatched":    { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Matched no pending request, including later answers to an already matched or expired request" }
            }
        },
        "meta_rx":                       { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "Alpenglow repair metadata responses received" },
        "meta_malformed_rejected":       { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "Metadata responses that failed to decode" },
        "meta_unsolicited_rejected":     { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "Metadata responses matching no outstanding request" },
        "parent_fec_set_count_accepted": { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "ParentFecSetCount responses accepted" },
        "parent_fec_set_count_failed":   { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "ParentFecSetCount responses that failed verification" },
        "fec_set_root_accepted":         { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "FecSetRoot responses accepted" },
        "fec_set_root_failed":           { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "FecSetRoot responses that failed verification" },
        "replay_root_advanced_rx":       { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "Root advanced messages received from replay" },
        "replay_missing_fec_rx":         { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "Missing FEC messages received from replay, each a from-root reconsume" },
        "ping_rejected": {
            "type": "Tuple",
            "description": "Pings rejected, by reason",
            "aliases": {
                "all": ["malformed", "unknown_peer", "signature_failed"]
            },
            "fields": {
                "malformed":        { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Failed to decode" },
                "unknown_peer":     { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Sender is not a known peer" },
                "signature_failed": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Signature did not verify" }
            }
        },
        "response_latency_nanos": {
            "type": "Tuple",
            "description": "Time from sending a repair request to receiving its response",
            "fields": {
                "b0":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[0, 10000000) nanos" },
                "b1":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[10000000, 13894955) nanos" },
                "b2":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[13894955, 19306977) nanos" },
                "b3":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[19306977, 26826958) nanos" },
                "b4":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[26826958, 37275937) nanos" },
                "b5":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[37275937, 51794747) nanos" },
                "b6":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[51794747, 71968568) nanos" },
                "b7":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[71968568, 100000001) nanos" },
                "b8":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[100000001, 138949551) nanos" },
                "b9":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[138949551, 193069775) nanos" },
                "b10": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[193069775, 268269582) nanos" },
                "b11": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[268269582, 372759375) nanos" },
                "b12": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[372759375, 517947471) nanos" },
                "b13": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[517947471, 719685675) nanos" },
                "b14": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[719685675, 1000000000) nanos" },
                "b15": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[1000000000, inf) nanos" },
                "sum": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Sum of samples (nanos)" }
            }
        },
        "retry_delay_nanos": {
            "type": "Tuple",
            "description": "Delay scheduled before a request's next attempt: its peer's hedge time (at most 500 ms) with the per-attempt backoff, none after an escape, at most 1 s",
            "fields": {
                "b0":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[0, 10000000) nanos" },
                "b1":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[10000000, 18615210) nanos" },
                "b2":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[18615210, 34652605) nanos" },
                "b3":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[34652605, 64506553) nanos" },
                "b4":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[64506553, 120080305) nanos" },
                "b5":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[120080305, 223532013) nanos" },
                "b6":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[223532013, 416109543) nanos" },
                "b7":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[416109543, 774596665) nanos" },
                "b8":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[774596665, 1441927981) nanos" },
                "b9":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[1441927981, 2684179260) nanos" },
                "b10": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[2684179260, 4996656140) nanos" },
                "b11": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[4996656140, 9301380482) nanos" },
                "b12": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[9301380482, 17314715371) nanos" },
                "b13": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[17314715371, 32231706785) nanos" },
                "b14": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[32231706785, 60000000000) nanos" },
                "b15": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[60000000000, inf) nanos" },
                "sum": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Sum of samples (nanos)" }
            }
        },
        "timeout_pending":               { "type": "UInt64",                     "compression": "T64, ZSTD",         "description": "Timeouts in the eager, notar and final timeout queues" },
        "timeout_cancelled":             { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "Timeouts dropped because their block is gone or their work is done" },
        "timeout_no_peer_deferred":      { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "Timeouts deferred because no peer could be picked" },
        "request_hedged":                { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "Request attempts after the first for the same timer" },
        "request_expired":               { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "Pending requests with no response after about 1 s (PENDING_TTL); a peer is banned for 10 s after 32 in a row, pending-pool evictions not counted" },
        "ping_probe_tx":                 { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "Requests sent to elicit a ping from a peer with a new address" },
        "eager_delay_nanos":             { "type": "UInt64",                     "compression": "T64, ZSTD",         "description": "Cluster-wide wait for turbine before a missing FEC set is repaired (srtt+4*rttvar, clamped to 20-250 ms; 250 ms until sampled)" },
        "sign_request_pending":          { "type": "UInt64",                     "compression": "T64, ZSTD",         "description": "Messages in the sign pool waiting for a signature from the sign tiles" },
        "catchup_slot":                  { "type": "UInt64",                     "compression": "T64, ZSTD",         "description": "Highest slot past the window with a verified cert, the staked catchup target, 0 if none" },
        "request_by_id_expired":         { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "WindowIndexForBlockId requests that expired unanswered, at or above the root" },
        "request_stuck_escaped":         { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "Retries sent to random staked peers because 3 attempts in a row brought no new shred of the FEC set" },
        "peer_by_id_banned":             { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "Peers banned for 10 s after 4 WindowIndexForBlockId requests in a row expired, whatever their other replies" },
        "request_fanout_sent":           { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "Extra staked peers an escaped WindowIndexForBlockId retry was also sent to, up to 2 per retry" },
        "request_late_retried":          { "type": "UInt64",                     "compression": "DoubleDelta, ZSTD", "description": "Request attempts sent after 3 or more earlier attempts for the same timer" },
        "escape_peer_hedge_delay_nanos": {
            "type": "Tuple",
            "description": "Uncapped hedge time (srtt+4*rttvar, 200 ms if unmeasured) of each staked peer an escaped retry was sent to",
            "fields": {
                "b0":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[0, 10000000) nanos" },
                "b1":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[10000000, 16378937) nanos" },
                "b2":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[16378937, 26826958) nanos" },
                "b3":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[26826958, 43939706) nanos" },
                "b4":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[43939706, 71968568) nanos" },
                "b5":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[71968568, 117876865) nanos" },
                "b6":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[117876865, 193069775) nanos" },
                "b7":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[193069775, 316227769) nanos" },
                "b8":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[316227769, 517947472) nanos" },
                "b9":  { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[517947472, 848342904) nanos" },
                "b10": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[848342904, 1389495502) nanos" },
                "b11": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[1389495502, 2275845935) nanos" },
                "b12": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[2275845935, 3727593730) nanos" },
                "b13": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[3727593730, 6105402305) nanos" },
                "b14": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[6105402305, 10000000000) nanos" },
                "b15": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "[10000000000, inf) nanos" },
                "sum": { "type": "UInt64", "compression": "DoubleDelta, ZSTD", "description": "Sum of samples (nanos)" }
            }
        }
    }
}
