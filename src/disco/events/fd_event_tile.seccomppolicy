# logfile_fd: It can be disabled by configuration, but typically tiles
#             will open a log file on boot and write all messages there.
#
# epoll_inner_fd: Kernel file descriptors are waited by a separate tile
#                 (the waker) for scheduling reasons, so the client's
#                 TCP socket should be added to this epoll set.
#
# epoll_outer_fd: The waker puts our inner set into another set, so it
#                 can poll all file descriptors across all tiles at once.
#                 This tile needs access to the outer file descriptor to
#                 rearm the inner set after a drain.
uint logfile_fd, uint etc_hosts_fd, uint etc_resolv_conf, uint epoll_inner_fd, uint epoll_outer_fd

# logging: all log messages are written to a file and/or pipe
#
# 'WARNING' and above are written to the STDERR pipe, while all messages
# are always written to the log file.
#
# arg 0 is the file descriptor to write to.  The boot process ensures
# that descriptor 2 is always STDERR and descriptor 4 is the logfile.
write: (or (eq (arg 0) 2)
           (eq (arg 0) logfile_fd))

# logging: 'WARNING' and above fsync the logfile to disk immediately
#
# arg 0 is the file descriptor to fsync.
fsync: (eq (arg 0) logfile_fd)

# client: need to be able to establish connections to the event server.
# resolv: need to query IPv4 or IPv6 nameservers.
socket: (and (or (eq (arg 0) "AF_INET")
                 (eq (arg 0) "AF_INET6"))
#             (eq (arg 1) "SOCK_STREAM|SOCK_NONBLOCK") TODO: UNCOMMENTING CAUSES SIGSYS ?
             (eq (arg 2) 0))

# resolv: Bind DNS request socket
bind: (or (eq (arg 2) "sizeof(struct sockaddr_in)")
          (eq (arg 2) "sizeof(struct sockaddr_in6)"))

# resolv: Wait for DNS responses
ppoll

# resolv: Receive DNS responses
recvmsg: (or (eq (arg 2) "MSG_NOSIGNAL|MSG_DONTWAIT")
             (eq (arg 2) 0))

# resolv: Send DNS queries via UDP or TCP
sendmsg: (or (eq (arg 2) "MSG_NOSIGNAL|MSG_DONTWAIT")
             (eq (arg 2) "MSG_FASTOPEN|MSG_NOSIGNAL")
             (eq (arg 2) "MSG_NOSIGNAL"))

# client: need to be able to connect to the event server to send events.
#
# arg 0 is the file descriptor of the socket to connect to.  We will
# restrict this being called on STDERR or the logfile.
connect: (not (or (eq (arg 0) 2)
                  (eq (arg 0) etc_resolv_conf)
                  (eq (arg 0) etc_hosts_fd)
                  (eq (arg 0) logfile_fd)))

# client: need to close sockets that were opened when calls to connect
# fail.
#
# arg 0 is the file descriptor that we would like to close.  We will
# restrict this being called on STDERR or the logfile.
close: (not (or (eq (arg 0) 2)
                (eq (arg 0) etc_resolv_conf)
                (eq (arg 0) etc_hosts_fd)
                (eq (arg 0) logfile_fd)))

# client: we need to send tcp event data to the server.
#
# arg 0 is the file descriptor that we would like to send a request to.
# We will restrict this being called on STDERR or the logfile.
sendto: (and (not (or (eq (arg 0) 2)
                      (eq (arg 0) etc_resolv_conf)
                      (eq (arg 0) etc_hosts_fd)
                      (eq (arg 0) logfile_fd)))
             (eq (arg 3) "MSG_NOSIGNAL"))

# client: we need to be able to receive response data from the server.
#
# arg 0 is the file descriptor that we would like to send a request to.
# We will restrict this being called on STDERR or the logfile.
recvfrom: (and (not (or (eq (arg 0) 2)
                        (eq (arg 0) etc_resolv_conf)
                        (eq (arg 0) etc_hosts_fd)
                        (eq (arg 0) logfile_fd)))
               (eq (arg 3) "MSG_NOSIGNAL"))

# resolv: Read DNS config
lseek: (and (or (eq (arg 0) etc_resolv_conf)
                (eq (arg 0) etc_hosts_fd))
            (eq (arg 1) 0)
            (eq (arg 2) "SEEK_SET"))

# resolv: Read DNS config
# openssl: Read from TCP socket during TLS handshake
read

# client: TCP_NODELAY for low-latency connection to event server
# client: SO_SNDBUF to configure send buffer size
# resolv: socket options needed for DNS resolution
setsockopt: (or (and (eq (arg 1) SOL_TCP)
                     (eq (arg 2) TCP_NODELAY))
                (and (eq (arg 1) IPPROTO_TCP)
                     (eq (arg 2) TCP_FASTOPEN_CONNECT))
                (and (eq (arg 1) SOL_SOCKET)
                     (eq (arg 2) SO_SNDBUF))
                (and (eq (arg 1) SOL_SOCKET)
                     (eq (arg 2) SO_RCVBUF))
                (eq (arg 1) SOL_IP)
                (eq (arg 1) IPPROTO_IPV6))

# openssl: RAND_bytes requires getpid
getpid

# openssl: RAND_bytes requires getrandom
getrandom

# waker: register the TCP socket in the tile's inner epoll set on
# (re)connect, and rearm the tile's entry in the waker's outer epoll
# set after servicing
#
# arg 0 is the epoll fd being modified.  The tile may modify its own
# inner set freely, and may only touch its own inner fd's entry in the
# outer set.
epoll_ctl: (or (eq (arg 0) epoll_inner_fd)
               (and (eq (arg 0) epoll_outer_fd)
                    (eq (arg 2) epoll_inner_fd)))
