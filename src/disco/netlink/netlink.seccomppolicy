# logfile_fd: It can be disabled by configuration, but typically tiles
#             will open a log file on boot and write all messages there.
#
# nl_mon_fd: An rtnetlink socket used to monitor updates
# nl_req_fd: An rtnetlink socket used for request-reply
# arp_probe_fd: A UDP socket used to indirectly generate ARP probes
#
# epoll_inner_fd: Kernel file descriptors are waited by a separate tile
#                 (the waker) for scheduling reasons, so the netlink
#                 monitor socket should be added to this epoll set.
#
# epoll_outer_fd: The waker puts our inner set into another set, so it
#                 can poll all file descriptors across all tiles at once.
#                 This tile needs access to the outer file descriptor to
#                 rearm the inner set after a drain.
uint logfile_fd, uint nl_mon_fd, uint nl_req_fd, uint arp_probe_fd, uint epoll_inner_fd, uint epoll_outer_fd

# logging: all log messages are written to a file and/or pipe
#
# 'WARNING' and above are written to the STDERR pipe, while all messages
# are always written to the log file.
#
# arg 0 is the file descriptor to write to.  The boot process ensures
# that descriptor 2 is always STDERR and descriptor 4 is the logfile.
write: (or (eq (arg 0) 2)
           (eq (arg 0) logfile_fd))

# logging: 'WARNING' and above fsync the logfile to disk immediately
#
# arg 0 is the file descriptor to fsync.  The boot process ensures that
# descriptor 3 is always the logfile.
fsync: (eq (arg 0) logfile_fd)

# nl_req_fd: Periodically send read-only/unprivileged rtnetlink requests
#
# arp_probe_fd: Send UDP packets that cause the kernel to generate ARP
# requests
#
# (In theory could use send(2) but that syscall doesn't exist on arm64)
sendto: (or (and (eq (arg 0) nl_req_fd)
                 (eq (arg 3) 0)
                 (eq (arg 4) 0)
                 (eq (arg 5) 0))
            (and (eq (arg 0) arp_probe_fd)
                 (eq (arg 1) 0)
                 (eq (arg 2) 0)
                 (eq (arg 3) MSG_DONTWAIT)
                 (eq (arg 5) FD_SOCKADDR_IN_SZ)))

# nl_mon_fd: Monitor for asynchronous rtnetlink updates
#
# nl_req_fd: Read replies to rtnetlink requests
#
# (Using recvfrom(2) instead of recv(2) for same ABI reasons as above)
recvfrom: (and (or (eq (arg 0) nl_mon_fd)
                   (eq (arg 0) nl_req_fd))
               (or (eq (arg 3) 0)
                   (eq (arg 3) MSG_DONTWAIT))
               (eq (arg 4) 0)
               (eq (arg 5) 0))

# waker: rearm the tile's entry in the waker's outer epoll set after
# draining the monitor socket
#
# arg 0 is the epoll fd being modified.  The tile registers nl_mon_fd
# in its inner set at boot (pre-sandbox), so at runtime it only needs
# to touch its own inner fd's entry in the outer set.
epoll_ctl: (and (eq (arg 0) epoll_outer_fd)
                (eq (arg 2) epoll_inner_fd))

# waker: reduce CPU usage by sleeping between readiness word checks
clock_nanosleep: (and (eq (arg 0) CLOCK_REALTIME)
                      (eq (arg 1) 0))
