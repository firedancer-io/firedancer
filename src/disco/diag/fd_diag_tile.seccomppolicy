# logfile_fd: It can be disabled by configuration, but typically tiles
#             will open a log file on boot and write all messages there.
uint logfile_fd

# logging: all log messages are written to a file and/or pipe
#
# 'WARNING' and above are written to the STDERR pipe, while all
# messages are always written to the log file.
#
# arg 0 is the file descriptor to write to.  The boot process ensures
# that descriptor 2 is always STDERR.
write: (or (eq (arg 0) 2)
           (eq (arg 0) logfile_fd))

# logging: 'WARNING' and above fsync the logfile to disk immediately
#
# arg 0 is the file descriptor to fsync.
fsync: (eq (arg 0) logfile_fd)

# metrics: retrieve number of context switches by rereading /proc
#
# arg 0 is the file descriptor to seek.  It can be any of the
# /proc/status file descriptors or /proc/interrupts, /proc/softirqs
# or /proc/stat opened during privileged init.  To accommodate this,
# we allow any file descriptor except those which we know are not
# these /proc/status files, which are the log file and STDOUT.
lseek: (and (not (or (eq (arg 0) 2)
                 (eq (arg 0) logfile_fd)))
            (eq (arg 1) 0)
            (eq (arg 2) "SEEK_SET"))

# metrics: retrieve number of context switches by rereading /proc
#
# arg 0 is the file descriptor to read.  It can be any of the
# /proc/status file descriptors or /proc/interrupts, /proc/softirqs
# or /proc/stat opened during privileged init.  To accommodate this,
# we allow any file descriptor except those which we know are not
# these /proc/status files, which are the log file and STDOUT.
read: (not (or (eq (arg 0) 2)
               (eq (arg 0) logfile_fd)))

# system summary: retained data descriptors are constrained by the
# sandbox descriptor allowlist.  The logfile is included for st_size.
fstat: (not (eq (arg 0) 2))

# system summary: sample live disk capacity and free space
fstatfs: (not (eq (arg 0) 2))

# metrics: reduce CPU usage by sleeping
clock_nanosleep: (and (eq (arg 0) CLOCK_REALTIME)
                      (eq (arg 1) 0)
                      (eq (arg 3) 0))

# power saving: sleep until the next report is due
#
# The diag tile only has periodic work, so it parks on its sleep word
# with futex_wait until its next deadline in both scheduler modes.
#
# arg 1 is the futex op, always FUTEX_WAIT_BITSET so the timeout is an
# absolute deadline.  arg 2 is the expected value of the word, always 0
# (parked).
futex: (and (eq (arg 1) FUTEX_WAIT_BITSET)
            (eq (arg 2) 0))

# power saving: resume an interrupted sleep
#
# A signal delivered to a parked tile interrupts its futex_wait, and the
# kernel resumes the wait with the remaining timeout via restart_syscall
# when the tile next runs.
restart_syscall
