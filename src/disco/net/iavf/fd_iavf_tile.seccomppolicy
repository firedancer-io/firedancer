# logfile_fd: It can be disabled by configuration, but typically tiles
#             open a log file on boot and write all messages there.
#
# lo_tx_fd: Send-only raw IPv4 socket bound to lo, owned by iavf:0.
uint logfile_fd, uint lo_tx_fd

# logging: write log messages to the logfile and/or STDERR pipe
#
# The configured severity thresholds determine which messages are
# written to STDERR and when the logfile is flushed.
#
# arg 0 is STDERR (descriptor 2) or the configured logfile descriptor.
write: (or (eq (arg 0) 2)
           (eq (arg 0) logfile_fd))

# logging: flush messages at or above the configured flush threshold
#
# arg 0 is the logfile descriptor to fsync.
fsync: (eq (arg 0) logfile_fd)

# iavf: send loopback packets through the raw IPv4 socket
#
# arg 0 is the loopback socket. arg 2 limits the batch to 64 packets
# and arg 3 requires a nonblocking send.
sendmmsg: (and (eq (arg 0) lo_tx_fd)
               (<= (arg 2) 64)
               (eq (arg 3) MSG_DONTWAIT))

# power saving: park until another tile wakes us or the next deadline
#
# arg 0 is the tile's sleep word. arg 1 selects FUTEX_WAIT_BITSET and
# arg 2 is the expected value, zero while parked. arg 4 is unused and
# arg 5 is FUTEX_BITSET_MATCH_ANY so any wakeup bit can wake the tile.
futex: (and (eq (arg 1) FUTEX_WAIT_BITSET)
            (eq (arg 2) 0)
            (eq (arg 4) 0)
            (eq (arg 5) FUTEX_BITSET_MATCH_ANY))

# logging: return from the crash signal handler without replacing the
# original crash signal with SIGSYS.
rt_sigreturn
