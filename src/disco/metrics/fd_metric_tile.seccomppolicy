# logfile_fd: It can be disabled by configuration, but typically tiles
#             will open a log file on boot and write all messages there.
#
# metrics_socket_fd: The metric tile serves a prometheus compatible HTTP
#                    endpoint, which is over TCP and does not use our
#                    XDP program.  It uses regular kernel sockets, so
#                    this is the socket file descriptor.
#
# epoll_inner_fd: Kernel file descriptors are waited by a separate tile
#                 (the waker) for scheduling reasons, so file
#                 descriptors from server connections should be added
#                 to this epoll set.
#
# epoll_outer_fd: The waker puts our inner set into another set, so it
#                 can poll all file descriptors across all tiles at once.
#                 This tile needs access to the outer file descriptor to
#                 rearm the inner set after a drain.
uint logfile_fd, uint metrics_socket_fd, uint epoll_inner_fd, uint epoll_outer_fd

# logging: all log messages are written to a file and/or pipe
#
# 'WARNING' and above are written to the STDERR pipe, while all messages
# are always written to the log file.
#
# arg 0 is the file descriptor to write to.  The boot process ensures
# that descriptor 2 is always STDERR and descriptor 4 is the logfile.
write: (or (eq (arg 0) 2)
           (eq (arg 0) logfile_fd))

# logging: 'WARNING' and above fsync the logfile to disk immediately
#
# arg 0 is the file descriptor to fsync.
fsync: (eq (arg 0) logfile_fd)

# server: serving pages over HTTP requires accepting connections
#
# arg 0 is the listen socket file descriptor to accept connections on.
accept4: (and (eq (arg 0) metrics_socket_fd)
              (eq (arg 1) 0)
              (eq (arg 2) 0)
              (eq (arg 3) "SOCK_CLOEXEC|SOCK_NONBLOCK"))

# server: serving pages over HTTP requires reading from connections
#
# arg 0 is the file descriptor to read from.  It can be any of the
# connected client sockets returned by accept4(2).  To accommodate this,
# we allow any file descriptor except those which we know are not these
# connected clients, which are the log file, STDERR, and the listening
# socket itself.
read: (not (or (eq (arg 0) 2)
               (eq (arg 0) logfile_fd)
               (eq (arg 0) metrics_socket_fd)))

# server: serving pages over HTTP requires writing to connections
#
# arg 0 is the file descriptor to send to.  It can be any of the
# connected client sockets returned by accept4(2).  To accommodate this,
# we allow any file descriptor except those which we know are not these
# connected clients, which are the log file, STDERR, and the listening
# socket itself.
sendto: (not (or (eq (arg 0) 2)
                 (eq (arg 0) logfile_fd)
                 (eq (arg 0) metrics_socket_fd)))

# server: serving pages over HTTP requires closing connections
#
# arg 0 is the file descriptor to close.  It can be any of the connected
# client sockets returned by accept4(2).  To accommodate this, we allow
# any file descriptor except those which we know are not these connected
# clients, which are the log file, STDERR, and the listening socket
# itself.
close: (not (or (eq (arg 0) 2)
                (eq (arg 0) logfile_fd)
                (eq (arg 0) metrics_socket_fd)))


# waker: discover ready connections in the tile's inner epoll set
#
# arg 0 is the epoll fd to wait on, which is always the tile's inner
# epoll fd.  arg 4 is the signal mask, which is always NULL.
epoll_pwait: (and (eq (arg 0) epoll_inner_fd)
                  (eq (arg 4) 0))

# waker: register/deregister connections and manage EPOLLOUT interest
# in the tile's inner epoll set, and rearm the tile's entry in the
# waker's outer epoll set after draining
#
# arg 0 is the epoll fd being modified.  The tile may modify its own
# inner set freely, and may only touch its own inner fd's entry in the
# outer set.
epoll_ctl: (or (eq (arg 0) epoll_inner_fd)
               (and (eq (arg 0) epoll_outer_fd)
                    (eq (arg 2) epoll_inner_fd)))

# waker: reduce CPU usage by sleeping between readiness word checks
clock_nanosleep: (and (eq (arg 0) CLOCK_REALTIME)
                      (eq (arg 1) 0))

# power saving: sleep when there is no work to do
#
# In the efficient scheduler mode, an idle tile parks on its sleep word
# with futex_wait until a producer has work for it or its next deadline
# passes.
#
# arg 1 is the futex op, always FUTEX_WAIT_BITSET so the timeout is an
# absolute deadline.  arg 2 is the expected value of the word, always 0
# (parked).
futex: (and (eq (arg 1) FUTEX_WAIT_BITSET)
            (eq (arg 2) 0))

# power saving: resume an interrupted sleep
#
# A signal delivered to a parked tile interrupts its futex_wait, and the
# kernel resumes the wait with the remaining timeout via restart_syscall
# when the tile next runs.
restart_syscall
