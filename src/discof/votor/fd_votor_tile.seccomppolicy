# logfile_fd: It can be disabled by configuration, but typically tiles
#             will open a log file on boot and write all messages there.
#
# dir_fd: The directory holding the vote history file.
#
# vote_history_fd_0, vote_history_fd_1: The staging and live vote
#                                       history files.  They swap roles
#                                       after every write.
uint logfile_fd, uint dir_fd, uint vote_history_fd_0, uint vote_history_fd_1

# logging: all log messages are written to a file and/or pipe
#
# 'WARNING' and above are written to the STDERR pipe, while all messages
# are always written to the log file.
#
# arg 0 is the file descriptor to write to.  The boot process ensures
# that descriptor 2 is always STDERR.
write: (or (eq (arg 0) 2)
           (eq (arg 0) logfile_fd))

# logging: 'WARNING' and above fsync the logfile to disk immediately
#
# arg 0 is the file descriptor to fsync.
fsync: (eq (arg 0) logfile_fd)

# vote history: atomically replace the live vote history file with the
#               staging file
#
# The staging and live names are exchanged after every write, so the
# live file is always complete.  After an identity switch, the files
# are renamed to the new identity, and a file that already has that
# name is moved to an .old name.  A rename that replaces a file is not
# allowed.
#
# arg 0 and arg 2 are the directory file descriptors of the two names.
# arg 4 is the flags, RENAME_EXCHANGE (2) for a write, or
# RENAME_NOREPLACE (1) for a rename.
renameat2: (and (eq (arg 0) dir_fd)
                (eq (arg 2) dir_fd)
                (or (eq (arg 4) 1)
                    (eq (arg 4) 2)))

# vote history: write the vote history file to the staging file
#
# arg 0 is the file descriptor to write to.
pwritev2: (or (eq (arg 0) vote_history_fd_0)
              (eq (arg 0) vote_history_fd_1))

# vote history: the staging file might be longer than the new vote
# history so the staging file is truncated to its size.
#
# arg 0 is the file descriptor to truncate.
ftruncate: (or (eq (arg 0) vote_history_fd_0)
               (eq (arg 0) vote_history_fd_1))

# QUIC uses getrandom for cryptographically secure randomness.
getrandom

# power saving: sleep when there is no work to do
#
# In the efficient scheduler mode, an idle tile parks on its sleep word
# with futex_wait until a producer has work for it or its next deadline
# passes.
#
# arg 1 is the futex op, always FUTEX_WAIT_BITSET so the timeout is an
# absolute deadline.  arg 2 is the expected value of the word, always 0
# (parked).
futex: (and (eq (arg 1) FUTEX_WAIT_BITSET)
            (eq (arg 2) 0))

# power saving: resume an interrupted sleep
#
# A signal delivered to a parked tile interrupts its futex_wait, and the
# kernel resumes the wait with the remaining timeout via restart_syscall
# when the tile next runs.
restart_syscall
