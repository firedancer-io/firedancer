# logfile_fd: It can be disabled by configuration, but typically tiles
#             will open a log file on boot and write all messages there.
#
# dragon_socket_fd: The Dragon's Mouth server serves gRPC over HTTP/2,
#                   which is over TCP and does not use our XDP program.
#                   It uses regular kernel sockets, so this is the
#                   listening socket file descriptor.
#
# epoll_inner_fd: Kernel file descriptors are waited by a separate tile
#                 (the waker) for scheduling reasons, so file
#                 descriptors from server connections should be added
#                 to this epoll set.
#
# epoll_outer_fd: The waker puts our inner set into another set, so it
#                 can poll all file descriptors across all tiles at once.
#                 This tile needs access to the outer file descriptor to
#                 rearm the inner set after a drain.
#
# accdb_ro_fd: Read-only file descriptor onto the accdb data file.  The
#              tile uses preadv2 against this fd to read the state a
#              block left an account in, when it serves a commitment
#              level above processed.
uint logfile_fd, uint dragon_socket_fd, uint epoll_inner_fd, uint epoll_outer_fd, uint accdb_ro_fd

# logging: all log messages are written to a file and/or pipe
#
# 'WARNING' and above are written to the STDERR pipe, while all messages
# are always written to the log file.
#
# arg 0 is the file descriptor to write to.  The boot process ensures
# that descriptor 2 is always STDERR and descriptor 4 is the logfile.
write: (or (eq (arg 0) 2)
           (eq (arg 0) logfile_fd))

# logging: 'WARNING' and above fsync the logfile to disk immediately
#
# arg 0 is the file descriptor to fsync.
fsync: (eq (arg 0) logfile_fd)

# server: serving gRPC requires accepting connections
#
# arg 0 is the listen socket file descriptor to accept connections on.
# The server keeps every socket non-blocking; it does not ask for
# SOCK_CLOEXEC, because the tile never executes another program.
accept4: (and (eq (arg 0) dragon_socket_fd)
              (eq (arg 1) 0)
              (eq (arg 2) 0)
              (eq (arg 3) "SOCK_NONBLOCK"))

# server: an accepted connection is put in no-delay mode, so that a
# small response is not held back by Nagle's algorithm, and its TCP
# keepalive is tuned so that a peer that vanished without a FIN is
# detected in about a minute
setsockopt: (or (and (eq (arg 1) IPPROTO_TCP)
                     (eq (arg 2) TCP_NODELAY))
                (and (eq (arg 1) SOL_SOCKET)
                     (eq (arg 2) SO_KEEPALIVE))
                (and (eq (arg 1) IPPROTO_TCP)
                     (eq (arg 2) TCP_KEEPIDLE))
                (and (eq (arg 1) IPPROTO_TCP)
                     (eq (arg 2) TCP_KEEPINTVL))
                (and (eq (arg 1) IPPROTO_TCP)
                     (eq (arg 2) TCP_KEEPCNT))
                (and (eq (arg 1) IPPROTO_TCP)
                     (eq (arg 2) TCP_USER_TIMEOUT)))

# server: discover which of the server's own sockets are ready
#
# The tile polls the listening socket and its connections with a zero
# timeout; it never sleeps here, because the waker tile does the
# sleeping.  glibc's poll(2) is the poll syscall on x86-64 and ppoll on
# targets without it.
poll

ppoll

# server: reading requests from connections
#
# arg 0 is the file descriptor to receive from.  It can be any of the
# connected client sockets returned by accept4(2).  To accommodate this,
# we allow any file descriptor except those which we know are not these
# connected clients, which are the log file, STDERR, and the listening
# socket itself.
recvmsg: (and (not (or (eq (arg 0) 2)
                       (eq (arg 0) logfile_fd)
                       (eq (arg 0) dragon_socket_fd)))
              (eq (arg 2) "MSG_NOSIGNAL|MSG_DONTWAIT"))

# server: writing responses to connections
#
# arg 0 is the file descriptor to send to, with the same reasoning as
# recvmsg above.
sendmsg: (and (not (or (eq (arg 0) 2)
                       (eq (arg 0) logfile_fd)
                       (eq (arg 0) dragon_socket_fd)))
              (eq (arg 2) "MSG_NOSIGNAL|MSG_DONTWAIT"))

# server: closing connections
#
# arg 0 is the file descriptor to close.  It can be any of the connected
# client sockets returned by accept4(2).  To accommodate this, we allow
# any file descriptor except those which we know are not these connected
# clients, which are the log file, STDERR, and the listening socket
# itself.
close: (not (or (eq (arg 0) 2)
                (eq (arg 0) logfile_fd)
                (eq (arg 0) dragon_socket_fd)))

# waker: register connections in the tile's inner epoll set, and rearm
# the tile's entry in the waker's outer epoll set after a drain
#
# arg 0 is the epoll fd being modified.  The tile may modify its own
# inner set freely, and may only touch its own inner fd's entry in the
# outer set.
epoll_ctl: (or (eq (arg 0) epoll_inner_fd)
               (and (eq (arg 0) epoll_outer_fd)
                    (eq (arg 2) epoll_inner_fd)))

# accounts database: reading the state a block left an account in, when
# a subscriber asked for a commitment level above processed
#
# arg 0 is the file descriptor to read from.
preadv2: (eq (arg 0) accdb_ro_fd)

# shutdown: the tile returns from its clone trampoline, which exits
exit: (eq (arg 0) 0)
