# logfile_fd: It can be disabled by configuration, but typically tiles
#             will open a log file on boot and write all messages there.
#
# epoll_inner_fd: The tile's inner epoll fd, inherited from the boot
#                 process at a fixed number when the tile is a waker
#                 client (see fd_waker.h).  Server fds are registered
#                 here and readiness is discovered by epoll_pwait.
#                 UINT_MAX when not a waker client, so no epoll rule
#                 can match.
#
# epoll_outer_fd: The waker's outer epoll fd, which the tile may only
#                 touch to rearm its own inner fd entry after a drain.
#                 UINT_MAX when not a waker client.
uint logfile_fd, uint epoll_inner_fd, uint epoll_outer_fd

# logging: all log messages are written to a file and/or pipe
#
# 'WARNING' and above are written to the STDERR pipe, while all
# messages are always written to the log file.
#
# arg 0 is the file descriptor to write to.  The boot process ensures
# that descriptor 2 is always STDERR.
write: (or (eq (arg 0) 2)
           (eq (arg 0) logfile_fd))

# client: if a connectiion via connect() fails, close the file
# descriptor.  Only close the file descriptors opened via socket, so
# not STDERR nor the logfile.
#
# server: if a sendto a connection fails, close the file descriptor
#
# arg 0 is the file descriptor to close.
close: (not (or (eq (arg 0) logfile_fd)
                (eq (arg 0) 2)))

# server: read from an open connection that has been accepted
#
# arg 0 is the file descriptor to read.  We will restrict the file
# descriptor used for STDERR and logging.
read: (not (or (eq (arg 0) logfile_fd)
               (eq (arg 0) 2)))

# server: accept new connections
#
# arg 0 is the socket file descriptor.   We will restrict the file
# descriptor used for STDERR and logging.
accept4: (and (not (or (eq (arg 0) logfile_fd)
                       (eq (arg 0) 2)))
              (eq (arg 3) "SOCK_NONBLOCK|SOCK_CLOEXEC"))

# server: requires polling existing connections
ppoll

# client/server: need to send messages
#
# arg 0 is the file descriptor that we want to send messages to.  We
# will allow sending to any of the descriptors opened in the client.
# Only restrict from sending to the logfile and STDERR
sendto: (and (not (or (eq (arg 0) logfile_fd)
                      (eq (arg 0) 2)))
             (eq (arg 3) "MSG_NOSIGNAL")
             (eq (arg 4) 0)
             (eq (arg 5) 0))

# client: need to read from connections established by the client
#
# arg 0 is the file descriptor that we recieve messages from.  We will
# allow receiving to any of the descriptors opened in the client.  Only
# restrict from receiving to the logfile and STDERR
recvfrom: (and (not (or (eq (arg 0) logfile_fd)
                        (eq (arg 0) 2)))
               (eq (arg 3) 0)
               (eq (arg 4) 0)
               (eq (arg 5) 0))

# logging: 'WARNING' and above fsync the logfile to disk immediately
#
# arg 0 is the file descriptor to fsync.
fsync: (eq (arg 0) logfile_fd)

# waker: discover ready connections in the tile's inner epoll set
#
# arg 0 is the epoll fd to wait on, which is always the tile's inner
# epoll fd.  arg 4 is the signal mask, which is always NULL.
epoll_pwait: (and (eq (arg 0) epoll_inner_fd)
                  (eq (arg 4) 0))

# waker: register/deregister connections and manage EPOLLOUT interest
# in the tile's inner epoll set, and rearm the tile's entry in the
# waker's outer epoll set after draining
#
# arg 0 is the epoll fd being modified.  The tile may modify its own
# inner set freely, and may only touch its own inner fd's entry in the
# outer set.
epoll_ctl: (or (eq (arg 0) epoll_inner_fd)
               (and (eq (arg 0) epoll_outer_fd)
                    (eq (arg 2) epoll_inner_fd)))

# waker: reduce CPU usage by sleeping between readiness word checks
# (replaces the blocking ppoll timeout used in non-waker mode)
clock_nanosleep: (and (eq (arg 0) CLOCK_REALTIME)
                      (eq (arg 1) 0)
                      (eq (arg 3) 0))
