# logfile_fd: It can be disabled by configuration, but typically tiles
#             will open a log file on boot and write all messages there.
#
# fast_boot_min_fd/fast_boot_max_fd: The fast boot stream pool, one
#         read-write descriptor per pool file at the well known
#         FD_STRMK_FD numbers, opened by run.c before the sandbox
#         starts.  The tile writes the streams through these and never
#         opens or unlinks files itself.
#
# accdb_ro_fd: The read-only accounts database file descriptor, used
#         to read the accounts the snapshot manifest names.
#
# vote_stakes_fd: Disk backing for t-1 vote stakes sets beyond the
#                 in-memory cache.  Any tile reading a set that is not
#                 cached loads it, writing back the evicted set.
uint logfile_fd, uint fast_boot_min_fd, uint fast_boot_max_fd, uint accdb_ro_fd, uint vote_stakes_fd

# logging: all log messages are written to a file and/or pipe
#
# 'WARNING' and above are written to the STDERR pipe, while all
# messages are always written to the log file.
#
# fast boot stream: compressed stream bytes are appended to the pool
# file of the stream being written.
#
# arg 0 is the file descriptor to write to.  The boot process ensures
# that descriptor 2 is always STDERR.
write: (or (eq (arg 0) 2)
           (eq (arg 0) logfile_fd)
           (and (>= (arg 0) fast_boot_min_fd)
                (<= (arg 0) fast_boot_max_fd)))

# logging: 'WARNING' and above fsync the logfile to disk immediately
#
# arg 0 is the file descriptor to fsync.
fsync: (eq (arg 0) logfile_fd)

# fast boot stream: a pool file is emptied before a new stream is
# written into it, and the write position goes back to the start.
#
# arg 0 is the file descriptor to truncate or seek on.
ftruncate: (and (>= (arg 0) fast_boot_min_fd)
                (<= (arg 0) fast_boot_max_fd))
lseek: (and (>= (arg 0) fast_boot_min_fd)
            (<= (arg 0) fast_boot_max_fd))

# snapshot manifest: account reads on accdb cache miss
preadv2: (eq (arg 0) accdb_ro_fd)

# vote stakes: load a spilled t-1 set into the cache and write back the
# evicted set.
pread64: (eq (arg 0) vote_stakes_fd)
pwrite64: (eq (arg 0) vote_stakes_fd)

# power saving: sleep when there is no work to do, and wake the file
# server when a stream file changes
#
# In the efficient scheduler mode, an idle tile parks on its sleep word
# with futex_wait until a producer has work for it or its next deadline
# passes.  The file server sleeps in io_uring and does not poll, so it
# is woken explicitly.
#
# arg 1 is the futex op.  arg 2 of the park is the expected value of
# the word, always 0 (parked).
futex: (or (eq (arg 1) FUTEX_WAKE)
           (and (eq (arg 1) FUTEX_WAIT_BITSET)
                (eq (arg 2) 0)))

# power saving: resume an interrupted sleep
#
# A signal delivered to a parked tile interrupts its futex_wait, and the
# kernel resumes the wait with the remaining timeout via restart_syscall
# when the tile next runs.
restart_syscall
