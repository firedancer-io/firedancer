# logfile_fd: It can be disabled by configuration, but typically tiles
#             will open a log file on boot and write all messages there.
#
# dir_fd: The file descriptor of the snapshots directory, used to
#         rename snapshot pool files.
#
# pool_min_fd/pool_max_fd: The snapshot pool file descriptor range
#         [pool_min_fd,pool_max_fd].  The boot process opens one
#         buffered write descriptor per managed snapshot file at the
#         well known FD_BACKUP_POOL_FD numbers before the tile is
#         spawned; the tile writes snapshots through these and never
#         opens or unlinks files itself.
uint logfile_fd, uint dir_fd, uint pool_min_fd, uint pool_max_fd

# logging: all log messages are written to a file and/or pipe
#
# 'WARNING' and above are written to the STDERR pipe, while all
# messages are always written to the log file.
#
# snapshot: compressed snapshot bytes are written sequentially to the
# snapshot pool file descriptor of the slot being produced.
#
# arg 0 is the file descriptor to write to.  The boot process ensures
# that descriptor 2 is always STDERR.
write: (or (eq (arg 0) 2)
           (eq (arg 0) logfile_fd)
           (and (>= (arg 0) pool_min_fd)
                (<= (arg 0) pool_max_fd)))

# logging: 'WARNING' and above fsync the logfile to disk immediately
#
# arg 0 is the file descriptor to fsync.
fsync: (eq (arg 0) logfile_fd)

# snapshot: the tile tracks and aligns its write position in the
# snapshot file, and seeks past the regions the snapzp tiles pwrite.
#
# arg 0 is the file descriptor to seek on.
lseek: (and (>= (arg 0) pool_min_fd)
            (<= (arg 0) pool_max_fd))

# snapshot: "deleting" a snapshot truncates its pool file to zero
# (the sandbox forbids unlinking), and starting a snapshot truncates
# the target pool file in case a failed attempt left bytes behind.
#
# arg 0 is the file descriptor to truncate.
ftruncate: (and (>= (arg 0) pool_min_fd)
                (<= (arg 0) pool_max_fd))

# snapshot: a completed snapshot is renamed from its
# "snapshot<i>.partial" placeholder name to the final snapshot name,
# and an evicted snapshot is renamed back to its placeholder name.
#
# arg 0 is the file descriptor for the directory that the file is
# being renamed from.
#
# arg 2 is the file descriptor for the directory that the file is
# being renamed to.  This should be the same file descriptor as the
# one used in arg 0.
renameat: (and (eq (arg 0) dir_fd)
               (eq (arg 2) dir_fd))

# snapshot: before reading accounts, the tile parks the accdb
# compaction epoch and yields while waiting for the accdb tile to
# acknowledge the pause.
sched_yield

# shutdown: exit is called on shutdown
exit: (eq (arg 0) 0)
