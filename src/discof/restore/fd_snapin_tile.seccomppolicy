# logfile_fd: It can be disabled by configuration, but typically tiles
#             will open a log file on boot and write all messages there.
#
# accounts_fd: The file descriptor for the accounts database.  Execution
#              tiles may need to pull accounts into the cache from disk,
#              or purge out of cache to the disk to make forward
#              progress.
uint logfile_fd, uint accounts_fd, uint accounts_direct_fd, uint stake_spill_fd

# logging: all log messages are written to a file and/or pipe
#
# 'WARNING' and above are written to the STDERR pipe, while all messages
# are always written to the log file.
#
# arg 0 is the file descriptor to write to.  The boot process ensures
# that descriptor 2 is always STDERR.
write: (or (eq (arg 0) 2)
           (eq (arg 0) logfile_fd))

# logging: 'WARNING' and above fsync the logfile to disk immediately
#
# arg 0 is the file descriptor to fsync.
fsync: (eq (arg 0) logfile_fd)

# shutdown: exit is called on shutdown
exit: (eq (arg 0) 0)

# accounts database: read accounts after workers finish
#
# Tile 0 reads SlotHistory and feature accounts from the database.
#
# arg 0 is the file descriptor to read from.
preadv2: (eq (arg 0) accounts_fd)

# accounts database: allocate more space from the disk
#
# The accounts database allocates more space from the underlying storage
# device in chunks, as it runs out.
fallocate: (and (eq (arg 0) accounts_fd)
                (eq (arg 1) 0))

# stake delegations: full root and fork-delta records spilled beyond
# the in-memory delegation pools.
pread64: (eq (arg 0) stake_spill_fd)

# accounts database: write account records at explicit offsets
#
# Parallel snapshot loader tiles write the packed account records
# directly into their own partitions of the accounts file.
#
# Stake delegations may also spill full records to disk.
#
# arg 0 is the file descriptor to write to.
pwrite64: (or (eq (arg 0) accounts_direct_fd)
              (eq (arg 0) stake_spill_fd))

# power saving: sleep when there is no work to do
#
# In the efficient scheduler mode, an idle tile parks on its sleep word
# with futex_wait until a producer has work for it or its next deadline
# passes.
#
# arg 1 is the futex op, always FUTEX_WAIT_BITSET so the timeout is an
# absolute deadline.  arg 2 is the expected value of the word, always 0
# (parked).
futex: (and (eq (arg 1) FUTEX_WAIT_BITSET)
            (eq (arg 2) 0))

# power saving: resume an interrupted sleep
#
# A signal delivered to a parked tile interrupts its futex_wait, and the
# kernel resumes the wait with the remaining timeout via restart_syscall
# when the tile next runs.
restart_syscall
