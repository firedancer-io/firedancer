# logfile_fd: It can be disabled by configuration, but typically tiles
#             will open a log file on boot and write all messages there.
#
# accounts_fd: The file descriptor for the accounts database.  Execution
#              tiles may need to pull accounts into the cache from disk,
#              or purge out of cache to the disk to make forward
#              progress.
#
# spill_fd: An unlinked spill file in the snapshots directory holding
#           the full worst-case txncache staging capacity.  Entries are
#           written while parsing status cache slot deltas and read
#           back once when populating the txncache.
#
# txncache_fd: The file descriptor for the transaction cache disk
#              tier.  Cold status cache pages are spilled to and read
#              back from this file.
uint logfile_fd, uint accounts_fd, uint stake_spill_fd, uint spill_fd, uint txncache_fd

# logging: all log messages are written to a file and/or pipe
#
# 'WARNING' and above are written to the STDERR pipe, while all messages
# are always written to the log file.
#
# arg 0 is the file descriptor to write to.  The boot process ensures
# that descriptor 2 is always STDERR.
write: (or (eq (arg 0) 2)
           (eq (arg 0) logfile_fd))

# logging: 'WARNING' and above fsync the logfile to disk immediately
#
# arg 0 is the file descriptor to fsync.
fsync: (eq (arg 0) logfile_fd)

# shutdown: exit is called on shutdown
exit: (eq (arg 0) 0)

# accounts database: allocate more space from the disk
#
# The accounts database allocates more space from the underlying storage
# device in chunks, as it runs out.
fallocate: (and (eq (arg 0) accounts_fd)
                (eq (arg 1) 0))

# stake delegations: disk overflow of the pubkey fallback tier, only
# touched in fallback mode; txncache staging spill: per-slot staging
# window flushes while parsing status cache slot deltas, read back when
# populating the txncache.
#
# txncache disk tier: reads of spilled status cache entries
pread64: (or (eq (arg 0) stake_spill_fd)
             (eq (arg 0) spill_fd)
             (eq (arg 0) txncache_fd))

# stake delegations + txncache staging spill (see pread64)
#
# txncache disk tier: spill cold status cache pages when the RAM
# window runs out during insert
pwrite64: (or (eq (arg 0) stake_spill_fd)
              (eq (arg 0) spill_fd)
              (eq (arg 0) txncache_fd))
