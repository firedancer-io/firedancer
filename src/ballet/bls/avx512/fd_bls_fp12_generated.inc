  fd_bls_fp_wide_addmul( &flipped, &x->c[5], &x2[10] ); /* flipped += 2x5*x10. */
  fd_bls_fp_wide_sub_raw( &w[8], &flipped ); /* w8 -= flipped. */
  fd_bls_fp_wide_add_raw( &w[9], &flipped ); /* w9 += flipped. */
  fd_bls_fp_wide_addmul( &w[8], &x->c[0], &x2[8] ); /* w[8] += 2x0*x8. */
