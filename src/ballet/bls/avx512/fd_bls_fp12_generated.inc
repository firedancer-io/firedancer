  fd_bls_fp_wide_addmul( &w[8], &x->c[2], &x2[6] ); /* w[8] += 2x2*x6. */
  fd_bls_fp_wide_addmul( &w[8], &x->c[3], &neg_x2[3] ); /* w[8] -= 2x3*x7. */
  fd_bls_fp_wide_addmul( &w[9], &x->c[0], &x2[9] ); /* w[9] += 2x0*x9. */
  fd_bls_fp_wide_addmul( &w[9], &x->c[1], &x2[8] ); /* w[9] += 2x1*x8. */
  fd_bls_fp_wide_addmul( &w[9], &x->c[2], &x2[7] ); /* w[9] += 2x2*x7. */
  fd_bls_fp_wide_addmul( &w[9], &x->c[3], &x2[6] ); /* w[9] += 2x3*x6. */
  fd_bls_fp_wide_offset( &common ); /* common = 0 mod p. */
  w[10] = common; /* w10 starts with terms shared by c10 and c11. */
  w[11] = common; /* w11 starts with the same shared terms. */
  fd_bls_fp_wide_addmul( &w[10], &x->c[0], &x2[10] ); /* w[10] += 2x0*x10. */
  fd_bls_fp_wide_addmul( &w[10], &x->c[1], &neg_x2[5] ); /* w[10] -= 2x1*x11. */
  fd_bls_fp_wide_addmul( &w[10], &x->c[2], &x2[8] ); /* w[10] += 2x2*x8. */
  fd_bls_fp_wide_addmul( &w[10], &x->c[3], &neg_x2[4] ); /* w[10] -= 2x3*x9. */
  fd_bls_fp_wide_addmul( &w[10], &x->c[4], &x2[6] ); /* w[10] += 2x4*x6. */
  fd_bls_fp_wide_addmul( &w[10], &x->c[5], &neg_x2[3] ); /* w[10] -= 2x5*x7. */
  fd_bls_fp_wide_addmul( &w[11], &x->c[0], &x2[11] ); /* w[11] += 2x0*x11. */
  fd_bls_fp_wide_addmul( &w[11], &x->c[1], &x2[10] ); /* w[11] += 2x1*x10. */
  fd_bls_fp_wide_addmul( &w[11], &x->c[2], &x2[9] ); /* w[11] += 2x2*x9. */
  fd_bls_fp_wide_addmul( &w[11], &x->c[3], &x2[8] ); /* w[11] += 2x3*x8. */
  fd_bls_fp_wide_addmul( &w[11], &x->c[4], &x2[7] ); /* w[11] += 2x4*x7. */
  fd_bls_fp_wide_addmul( &w[11], &x->c[5], &x2[6] ); /* w[11] += 2x5*x6. */
  fd_bls_fp_reduce_wide_batch4( &out->c[0], &w[0] ); /* out.c0:4 = w0:4 mod p. */
  fd_bls_fp_reduce_wide_batch4( &out->c[4], &w[4] ); /* out.c4:8 = w4:8 mod p. */
  fd_bls_fp_reduce_wide_batch4( &out->c[8], &w[8] ); /* out.c8:12 = w8:12 mod p. */
}

/* Multiply by l0+l1*u+(l2+l3*u)*v+(l4+l5*u)*w*v. */
static void
