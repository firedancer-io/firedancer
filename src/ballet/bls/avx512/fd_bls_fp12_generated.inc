  fd_bls_fp_wide_addmul( &common, &x->c[10], &line[4] ); /* common += x10*l4. */
  fd_bls_fp_wide_addmul( &common, &x->c[11], &neg_y[2] ); /* common -= x11*l5. */
  w[2] = common; /* w2 starts with terms shared by c2 and c3. */
  w[3] = common; /* w3 starts with the same shared terms. */
  fd_bls_fp_wide_mul_raw( &flipped, &x->c[10], &line[5] ); /* flipped = x10*l5. */
  fd_bls_fp_wide_addmul( &flipped, &x->c[11], &line[4] ); /* flipped += x11*l4. */
  fd_bls_fp_wide_sub_raw( &w[2], &flipped ); /* w2 -= flipped. */
  fd_bls_fp_wide_add_raw( &w[3], &flipped ); /* w3 += flipped. */
  fd_bls_fp_wide_addmul( &w[2], &x->c[0], &line[2] ); /* w[2] += x0*l2. */
  fd_bls_fp_wide_addmul( &w[2], &x->c[1], &neg_y[1] ); /* w[2] -= x1*l3. */
  fd_bls_fp_wide_addmul( &w[2], &x->c[2], &line[0] ); /* w[2] += x2*l0. */
  fd_bls_fp_wide_addmul( &w[2], &x->c[3], &neg_y[0] ); /* w[2] -= x3*l1. */
  fd_bls_fp_wide_addmul( &w[3], &x->c[0], &line[3] ); /* w[3] += x0*l3. */
  fd_bls_fp_wide_addmul( &w[3], &x->c[1], &line[2] ); /* w[3] += x1*l2. */
  fd_bls_fp_wide_addmul( &w[3], &x->c[2], &line[1] ); /* w[3] += x2*l1. */
  fd_bls_fp_wide_addmul( &w[3], &x->c[3], &line[0] ); /* w[3] += x3*l0. */
  fd_bls_fp_wide_offset( &common ); /* common = 0 mod p. */
  w[4] = common; /* w4 starts with terms shared by c4 and c5. */
  w[5] = common; /* w5 starts with the same shared terms. */
  fd_bls_fp_wide_addmul( &w[4], &x->c[2], &line[2] ); /* w[4] += x2*l2. */
  fd_bls_fp_wide_addmul( &w[4], &x->c[3], &neg_y[1] ); /* w[4] -= x3*l3. */
  fd_bls_fp_wide_addmul( &w[4], &x->c[4], &line[0] ); /* w[4] += x4*l0. */
  fd_bls_fp_wide_addmul( &w[4], &x->c[5], &neg_y[0] ); /* w[4] -= x5*l1. */
  fd_bls_fp_wide_addmul( &w[4], &x->c[6], &line[4] ); /* w[4] += x6*l4. */
  fd_bls_fp_wide_addmul( &w[4], &x->c[7], &neg_y[2] ); /* w[4] -= x7*l5. */
  fd_bls_fp_wide_addmul( &w[5], &x->c[2], &line[3] ); /* w[5] += x2*l3. */
  fd_bls_fp_wide_addmul( &w[5], &x->c[3], &line[2] ); /* w[5] += x3*l2. */
  fd_bls_fp_wide_addmul( &w[5], &x->c[4], &line[1] ); /* w[5] += x4*l1. */
  fd_bls_fp_wide_addmul( &w[5], &x->c[5], &line[0] ); /* w[5] += x5*l0. */
  fd_bls_fp_wide_addmul( &w[5], &x->c[6], &line[5] ); /* w[5] += x6*l5. */
  fd_bls_fp_wide_addmul( &w[5], &x->c[7], &line[4] ); /* w[5] += x7*l4. */
  fd_bls_fp_wide_offset( &common ); /* common = 0 mod p. */
  fd_bls_fp_wide_addmul( &common, &x->c[4], &line[4] ); /* common += x4*l4. */
  fd_bls_fp_wide_addmul( &common, &x->c[5], &neg_y[2] ); /* common -= x5*l5. */
  fd_bls_fp_wide_addmul( &common, &x->c[10], &line[2] ); /* common += x10*l2. */
  fd_bls_fp_wide_addmul( &common, &x->c[11], &neg_y[1] ); /* common -= x11*l3. */
  w[6] = common; /* w6 starts with terms shared by c6 and c7. */
  w[7] = common; /* w7 starts with the same shared terms. */
  fd_bls_fp_wide_mul_raw( &flipped, &x->c[4], &line[5] ); /* flipped = x4*l5. */
  fd_bls_fp_wide_addmul( &flipped, &x->c[5], &line[4] ); /* flipped += x5*l4. */
  fd_bls_fp_wide_addmul( &flipped, &x->c[10], &line[3] ); /* flipped += x10*l3. */
  fd_bls_fp_wide_addmul( &flipped, &x->c[11], &line[2] ); /* flipped += x11*l2. */
  fd_bls_fp_wide_sub_raw( &w[6], &flipped ); /* w6 -= flipped. */
  fd_bls_fp_wide_add_raw( &w[7], &flipped ); /* w7 += flipped. */
  fd_bls_fp_wide_addmul( &w[6], &x->c[6], &line[0] ); /* w[6] += x6*l0. */
  fd_bls_fp_wide_addmul( &w[6], &x->c[7], &neg_y[0] ); /* w[6] -= x7*l1. */
  fd_bls_fp_wide_addmul( &w[7], &x->c[6], &line[1] ); /* w[7] += x6*l1. */
  fd_bls_fp_wide_addmul( &w[7], &x->c[7], &line[0] ); /* w[7] += x7*l0. */
  fd_bls_fp_wide_offset( &common ); /* common = 0 mod p. */
  w[8] = common; /* w8 starts with terms shared by c8 and c9. */
  w[9] = common; /* w9 starts with the same shared terms. */
  fd_bls_fp_wide_addmul( &w[8], &x->c[0], &line[4] ); /* w[8] += x0*l4. */
  fd_bls_fp_wide_addmul( &w[8], &x->c[1], &neg_y[2] ); /* w[8] -= x1*l5. */
  fd_bls_fp_wide_addmul( &w[8], &x->c[6], &line[2] ); /* w[8] += x6*l2. */
  fd_bls_fp_wide_addmul( &w[8], &x->c[7], &neg_y[1] ); /* w[8] -= x7*l3. */
  fd_bls_fp_wide_addmul( &w[8], &x->c[8], &line[0] ); /* w[8] += x8*l0. */
  fd_bls_fp_wide_addmul( &w[8], &x->c[9], &neg_y[0] ); /* w[8] -= x9*l1. */
  fd_bls_fp_wide_addmul( &w[9], &x->c[0], &line[5] ); /* w[9] += x0*l5. */
  fd_bls_fp_wide_addmul( &w[9], &x->c[1], &line[4] ); /* w[9] += x1*l4. */
  fd_bls_fp_wide_addmul( &w[9], &x->c[6], &line[3] ); /* w[9] += x6*l3. */
  fd_bls_fp_wide_addmul( &w[9], &x->c[7], &line[2] ); /* w[9] += x7*l2. */
  fd_bls_fp_wide_addmul( &w[9], &x->c[8], &line[1] ); /* w[9] += x8*l1. */
  fd_bls_fp_wide_addmul( &w[9], &x->c[9], &line[0] ); /* w[9] += x9*l0. */
  fd_bls_fp_wide_offset( &common ); /* common = 0 mod p. */
  w[10] = common; /* w10 starts with terms shared by c10 and c11. */
  w[11] = common; /* w11 starts with the same shared terms. */
  fd_bls_fp_wide_addmul( &w[10], &x->c[2], &line[4] ); /* w[10] += x2*l4. */
  fd_bls_fp_wide_addmul( &w[10], &x->c[3], &neg_y[2] ); /* w[10] -= x3*l5. */
  fd_bls_fp_wide_addmul( &w[10], &x->c[8], &line[2] ); /* w[10] += x8*l2. */
  fd_bls_fp_wide_addmul( &w[10], &x->c[9], &neg_y[1] ); /* w[10] -= x9*l3. */
  fd_bls_fp_wide_addmul( &w[10], &x->c[10], &line[0] ); /* w[10] += x10*l0. */
  fd_bls_fp_wide_addmul( &w[10], &x->c[11], &neg_y[0] ); /* w[10] -= x11*l1. */
  fd_bls_fp_wide_addmul( &w[11], &x->c[2], &line[5] ); /* w[11] += x2*l5. */
  fd_bls_fp_wide_addmul( &w[11], &x->c[3], &line[4] ); /* w[11] += x3*l4. */
  fd_bls_fp_wide_addmul( &w[11], &x->c[8], &line[3] ); /* w[11] += x8*l3. */
  fd_bls_fp_wide_addmul( &w[11], &x->c[9], &line[2] ); /* w[11] += x9*l2. */
  fd_bls_fp_wide_addmul( &w[11], &x->c[10], &line[1] ); /* w[11] += x10*l1. */
  fd_bls_fp_wide_addmul( &w[11], &x->c[11], &line[0] ); /* w[11] += x11*l0. */
  fd_bls_fp_reduce_wide_batch4( &out->c[0], &w[0] ); /* out.c0:4 = w0:4 mod p. */
  fd_bls_fp_reduce_wide_batch4( &out->c[4], &w[4] ); /* out.c4:8 = w4:8 mod p. */
  fd_bls_fp_reduce_wide_batch4( &out->c[8], &w[8] ); /* out.c8:12 = w8:12 mod p. */
}

/* Squaring specialized to the cyclotomic subgroup. */
static void
fp12_cyclotomic_sqr_generated( fd_bls_fp12_t * out, fd_bls_fp12_t const * x ) {
  fd_bls_fp_t x2[12];
  fd_bls_fp_t neg_x[6], neg_x2[6];
  fd_bls_fp_t const one_third = {
    .m1 = wwv_ld( fd_bls_one_third_m1 ),
    .m2 = wwv_ld( fd_bls_one_third_m2 ) };
  fd_bls_fp_t const neg_two_thirds = {
    .m1 = wwv_ld( fd_bls_neg_two_thirds_m1 ),
    .m2 = wwv_ld( fd_bls_neg_two_thirds_m2 ) };
  fd_bls_fp_wide_t w[12], common, flipped;
  x2[0].m1 = wwv_add( x->c[0].m1, x->c[0].m1 ); /* x2_0=2x0, base M. */
  x2[0].m2 = wwv_add( x->c[0].m2, x->c[0].m2 ); /* x2_0=2x0, base N. */
  x2[1].m1 = wwv_add( x->c[1].m1, x->c[1].m1 ); /* x2_1=2x1, base M. */
  x2[1].m2 = wwv_add( x->c[1].m2, x->c[1].m2 ); /* x2_1=2x1, base N. */
  x2[2].m1 = wwv_add( x->c[2].m1, x->c[2].m1 ); /* x2_2=2x2, base M. */
  x2[2].m2 = wwv_add( x->c[2].m2, x->c[2].m2 ); /* x2_2=2x2, base N. */
  x2[3].m1 = wwv_add( x->c[3].m1, x->c[3].m1 ); /* x2_3=2x3, base M. */
  x2[3].m2 = wwv_add( x->c[3].m2, x->c[3].m2 ); /* x2_3=2x3, base N. */
  x2[4].m1 = wwv_add( x->c[4].m1, x->c[4].m1 ); /* x2_4=2x4, base M. */
  x2[4].m2 = wwv_add( x->c[4].m2, x->c[4].m2 ); /* x2_4=2x4, base N. */
  x2[5].m1 = wwv_add( x->c[5].m1, x->c[5].m1 ); /* x2_5=2x5, base M. */
  x2[5].m2 = wwv_add( x->c[5].m2, x->c[5].m2 ); /* x2_5=2x5, base N. */
  x2[6].m1 = wwv_add( x->c[6].m1, x->c[6].m1 ); /* x2_6=2x6, base M. */
  x2[6].m2 = wwv_add( x->c[6].m2, x->c[6].m2 ); /* x2_6=2x6, base N. */
  x2[7].m1 = wwv_add( x->c[7].m1, x->c[7].m1 ); /* x2_7=2x7, base M. */
  x2[7].m2 = wwv_add( x->c[7].m2, x->c[7].m2 ); /* x2_7=2x7, base N. */
  x2[8].m1 = wwv_add( x->c[8].m1, x->c[8].m1 ); /* x2_8=2x8, base M. */
  x2[8].m2 = wwv_add( x->c[8].m2, x->c[8].m2 ); /* x2_8=2x8, base N. */
  x2[9].m1 = wwv_add( x->c[9].m1, x->c[9].m1 ); /* x2_9=2x9, base M. */
  x2[9].m2 = wwv_add( x->c[9].m2, x->c[9].m2 ); /* x2_9=2x9, base N. */
  x2[10].m1 = wwv_add( x->c[10].m1, x->c[10].m1 ); /* x2_10=2x10, base M. */
  x2[10].m2 = wwv_add( x->c[10].m2, x->c[10].m2 ); /* x2_10=2x10, base N. */
  x2[11].m1 = wwv_add( x->c[11].m1, x->c[11].m1 ); /* x2_11=2x11, base M. */
  x2[11].m2 = wwv_add( x->c[11].m2, x->c[11].m2 ); /* x2_11=2x11, base N. */
  fd_bls_fp_neg( &neg_x[0], &x->c[1] ); /* neg_x0=-x1. */
  neg_x2[0].m1 = wwv_add( neg_x[0].m1, neg_x[0].m1 ); /* neg_x2_0=-2x1, base M. */
  neg_x2[0].m2 = wwv_add( neg_x[0].m2, neg_x[0].m2 ); /* neg_x2_0=-2x1, base N. */
  fd_bls_fp_neg( &neg_x[1], &x->c[3] ); /* neg_x1=-x3. */
  neg_x2[1].m1 = wwv_add( neg_x[1].m1, neg_x[1].m1 ); /* neg_x2_1=-2x3, base M. */
  neg_x2[1].m2 = wwv_add( neg_x[1].m2, neg_x[1].m2 ); /* neg_x2_1=-2x3, base N. */
  fd_bls_fp_neg( &neg_x[2], &x->c[5] ); /* neg_x2=-x5. */
  neg_x2[2].m1 = wwv_add( neg_x[2].m1, neg_x[2].m1 ); /* neg_x2_2=-2x5, base M. */
  neg_x2[2].m2 = wwv_add( neg_x[2].m2, neg_x[2].m2 ); /* neg_x2_2=-2x5, base N. */
  fd_bls_fp_neg( &neg_x[3], &x->c[7] ); /* neg_x3=-x7. */
  neg_x2[3].m1 = wwv_add( neg_x[3].m1, neg_x[3].m1 ); /* neg_x2_3=-2x7, base M. */
  neg_x2[3].m2 = wwv_add( neg_x[3].m2, neg_x[3].m2 ); /* neg_x2_3=-2x7, base N. */
  fd_bls_fp_neg( &neg_x[4], &x->c[9] ); /* neg_x4=-x9. */
  neg_x2[4].m1 = wwv_add( neg_x[4].m1, neg_x[4].m1 ); /* neg_x2_4=-2x9, base M. */
  neg_x2[4].m2 = wwv_add( neg_x[4].m2, neg_x[4].m2 ); /* neg_x2_4=-2x9, base N. */
  fd_bls_fp_neg( &neg_x[5], &x->c[11] ); /* neg_x5=-x11. */
  neg_x2[5].m1 = wwv_add( neg_x[5].m1, neg_x[5].m1 ); /* neg_x2_5=-2x11, base M. */
  neg_x2[5].m2 = wwv_add( neg_x[5].m2, neg_x[5].m2 ); /* neg_x2_5=-2x11, base N. */
  fd_bls_fp_wide_offset( &common ); /* common = 0 mod p before the final scale. */
  fd_bls_fp_wide_addmul( &common, &x->c[8], &x->c[8] ); /* common += x8*x8. */
  fd_bls_fp_wide_addmul( &common, &x->c[9], &neg_x[4] ); /* common -= x9*x9. */
  w[0] = common; /* w0 starts with normalized terms shared by c0 and c1. */
  w[1] = common; /* w1 starts with the same normalized terms. */
  fd_bls_fp_wide_mul_raw( &flipped, &x->c[8], &x2[9] ); /* flipped = 2x8*x9. */
  fd_bls_fp_wide_sub_raw( &w[0], &flipped ); /* w0 -= flipped. */
  fd_bls_fp_wide_add_raw( &w[1], &flipped ); /* w1 += flipped. */
  fd_bls_fp_wide_addmul( &w[0], &x->c[0], &x->c[0] ); /* w[0] += x0*x0. */
  fd_bls_fp_wide_addmul( &w[0], &x->c[0], &neg_two_thirds ); /* w[0] += -2/3*x0. */
  fd_bls_fp_wide_addmul( &w[0], &x->c[1], &neg_x[0] ); /* w[0] -= x1*x1. */
  fd_bls_fp_wide_addmul( &w[1], &x->c[1], &neg_two_thirds ); /* w[1] += -2/3*x1. */
  fd_bls_fp_wide_addmul( &w[1], &x->c[0], &x2[1] ); /* w[1] += 2x0*x1. */
  fd_bls_fp_wide_offset( &common ); /* common = 0 mod p before the final scale. */
  fd_bls_fp_wide_addmul( &common, &x->c[4], &x->c[4] ); /* common += x4*x4. */
  fd_bls_fp_wide_addmul( &common, &x->c[5], &neg_x[2] ); /* common -= x5*x5. */
  w[2] = common; /* w2 starts with normalized terms shared by c2 and c3. */
  w[3] = common; /* w3 starts with the same normalized terms. */
  fd_bls_fp_wide_mul_raw( &flipped, &x->c[4], &x2[5] ); /* flipped = 2x4*x5. */
  fd_bls_fp_wide_sub_raw( &w[2], &flipped ); /* w2 -= flipped. */
  fd_bls_fp_wide_add_raw( &w[3], &flipped ); /* w3 += flipped. */
  fd_bls_fp_wide_addmul( &w[2], &x->c[2], &neg_two_thirds ); /* w[2] += -2/3*x2. */
  fd_bls_fp_wide_addmul( &w[2], &x->c[6], &x->c[6] ); /* w[2] += x6*x6. */
  fd_bls_fp_wide_addmul( &w[2], &x->c[7], &neg_x[3] ); /* w[2] -= x7*x7. */
  fd_bls_fp_wide_addmul( &w[3], &x->c[3], &neg_two_thirds ); /* w[3] += -2/3*x3. */
  fd_bls_fp_wide_addmul( &w[3], &x->c[6], &x2[7] ); /* w[3] += 2x6*x7. */
  fd_bls_fp_wide_offset( &common ); /* common = 0 mod p before the final scale. */
  fd_bls_fp_wide_addmul( &common, &x->c[10], &x->c[10] ); /* common += x10*x10. */
  fd_bls_fp_wide_addmul( &common, &x->c[11], &neg_x[5] ); /* common -= x11*x11. */
  w[4] = common; /* w4 starts with normalized terms shared by c4 and c5. */
  w[5] = common; /* w5 starts with the same normalized terms. */
  fd_bls_fp_wide_mul_raw( &flipped, &x->c[10], &x2[11] ); /* flipped = 2x10*x11. */
  fd_bls_fp_wide_sub_raw( &w[4], &flipped ); /* w4 -= flipped. */
  fd_bls_fp_wide_add_raw( &w[5], &flipped ); /* w5 += flipped. */
  fd_bls_fp_wide_addmul( &w[4], &x->c[2], &x->c[2] ); /* w[4] += x2*x2. */
  fd_bls_fp_wide_addmul( &w[4], &x->c[3], &neg_x[1] ); /* w[4] -= x3*x3. */
  fd_bls_fp_wide_addmul( &w[4], &x->c[4], &neg_two_thirds ); /* w[4] += -2/3*x4. */
  fd_bls_fp_wide_addmul( &w[5], &x->c[5], &neg_two_thirds ); /* w[5] += -2/3*x5. */
  fd_bls_fp_wide_addmul( &w[5], &x->c[2], &x2[3] ); /* w[5] += 2x2*x3. */
  fd_bls_fp_wide_offset( &common ); /* common = 0 mod p before the final scale. */
  fd_bls_fp_wide_addmul( &common, &x->c[2], &x->c[10] ); /* common += x2*x10. */
  fd_bls_fp_wide_addmul( &common, &x->c[3], &neg_x[5] ); /* common -= x3*x11. */
  w[6] = common; /* w6 starts with normalized terms shared by c6 and c7. */
  w[7] = common; /* w7 starts with the same normalized terms. */
  fd_bls_fp_wide_mul_raw( &flipped, &x->c[2], &x->c[11] ); /* flipped = x2*x11. */
  fd_bls_fp_wide_addmul( &flipped, &x->c[3], &x->c[10] ); /* flipped += x3*x10. */
  fd_bls_fp_wide_sub_raw( &w[6], &flipped ); /* w6 -= flipped. */
  fd_bls_fp_wide_add_raw( &w[7], &flipped ); /* w7 += flipped. */
  fd_bls_fp_wide_addmul( &w[6], &x->c[6], &one_third ); /* w[6] += 1/3*x6. */
  fd_bls_fp_wide_addmul( &w[7], &x->c[7], &one_third ); /* w[7] += 1/3*x7. */
  fd_bls_fp_wide_offset( &common ); /* common = 0 mod p before the final scale. */
  w[8] = common; /* w8 starts with normalized terms shared by c8 and c9. */
  w[9] = common; /* w9 starts with the same normalized terms. */
  fd_bls_fp_wide_addmul( &w[8], &x->c[8], &one_third ); /* w[8] += 1/3*x8. */
  fd_bls_fp_wide_addmul( &w[8], &x->c[0], &x->c[8] ); /* w[8] += x0*x8. */
  fd_bls_fp_wide_addmul( &w[8], &x->c[1], &neg_x[4] ); /* w[8] -= x1*x9. */
  fd_bls_fp_wide_addmul( &w[9], &x->c[9], &one_third ); /* w[9] += 1/3*x9. */
  fd_bls_fp_wide_addmul( &w[9], &x->c[0], &x->c[9] ); /* w[9] += x0*x9. */
  fd_bls_fp_wide_addmul( &w[9], &x->c[1], &x->c[8] ); /* w[9] += x1*x8. */
  fd_bls_fp_wide_offset( &common ); /* common = 0 mod p before the final scale. */
  w[10] = common; /* w10 starts with normalized terms shared by c10 and c11. */
  w[11] = common; /* w11 starts with the same normalized terms. */
  fd_bls_fp_wide_addmul( &w[10], &x->c[10], &one_third ); /* w[10] += 1/3*x10. */
  fd_bls_fp_wide_addmul( &w[10], &x->c[4], &x->c[6] ); /* w[10] += x4*x6. */
  fd_bls_fp_wide_addmul( &w[10], &x->c[5], &neg_x[3] ); /* w[10] -= x5*x7. */
  fd_bls_fp_wide_addmul( &w[11], &x->c[11], &one_third ); /* w[11] += 1/3*x11. */
  fd_bls_fp_wide_addmul( &w[11], &x->c[4], &x->c[7] ); /* w[11] += x4*x7. */
  fd_bls_fp_wide_addmul( &w[11], &x->c[5], &x->c[6] ); /* w[11] += x5*x6. */
  fd_bls_fp_reduce_wide_scaled_batch6( &out->c[0], &w[0], 3U ); /* out.c0:6 = 3*w0:6 mod p. */
  fd_bls_fp_reduce_wide_scaled_batch6( &out->c[6], &w[6], 6U ); /* out.c6:12 = 6*w6:12 mod p. */
}
