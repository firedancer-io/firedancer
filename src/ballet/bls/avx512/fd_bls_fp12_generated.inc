  fd_bls_fp_wide_addmul( &flipped, &x->c[3], &x2[4] ); /* flipped += 2x3*x4. */
  fd_bls_fp_wide_addmul( &flipped, &x->c[6], &x2[11] ); /* flipped += 2x6*x11. */
  fd_bls_fp_wide_addmul( &flipped, &x->c[7], &x2[10] ); /* flipped += 2x7*x10. */
  fd_bls_fp_wide_addmul( &flipped, &x->c[8], &x2[9] ); /* flipped += 2x8*x9. */
