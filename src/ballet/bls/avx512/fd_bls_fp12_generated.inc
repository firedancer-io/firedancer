  vroom_fp_wide_addmul( &w[10], &x->c[10], &line[0] ); /* w[10] += x10*l0. */
  vroom_fp_wide_submul( &w[10], &x->c[11], &line[1] ); /* w[10] -= x11*l1. */
  vroom_fp_wide_addmul( &w[10], &x->c[2], &line[4] ); /* w[10] += x2*l4. */
  vroom_fp_wide_submul( &w[10], &x->c[3], &line[5] ); /* w[10] -= x3*l5. */
  vroom_fp_wide_addmul( &w[10], &x->c[8], &line[2] ); /* w[10] += x8*l2. */
  vroom_fp_wide_submul( &w[10], &x->c[9], &line[3] ); /* w[10] -= x9*l3. */
  vroom_fp_wide_addmul( &w[11], &x->c[10], &line[1] ); /* w[11] += x10*l1. */
  vroom_fp_wide_addmul( &w[11], &x->c[11], &line[0] ); /* w[11] += x11*l0. */
  vroom_fp_wide_addmul( &w[11], &x->c[2], &line[5] ); /* w[11] += x2*l5. */
  vroom_fp_wide_addmul( &w[11], &x->c[3], &line[4] ); /* w[11] += x3*l4. */
  vroom_fp_wide_addmul( &w[11], &x->c[8], &line[3] ); /* w[11] += x8*l3. */
  vroom_fp_wide_addmul( &w[11], &x->c[9], &line[2] ); /* w[11] += x9*l2. */
  vroom_fp_reduce_wide_batch6( &out->c[0], &w[0] ); /* out.c0:6 = w0:6 mod p. */
  vroom_fp_reduce_wide_batch6( &out->c[6], &w[6] ); /* out.c6:12 = w6:12 mod p. */
}

/* Squaring specialized to the cyclotomic subgroup. */
static void
fp12_cyclotomic_sqr_generated( vroom_fp12_t * out, vroom_fp12_t const * x ) {
  vroom_fp_t const one_third = {
    .m1 = wwv_ld( vroom_one_third_m1 ),
    .m2 = wwv_ld( vroom_one_third_m2 ) };
  vroom_fp_t const neg_two_thirds = {
    .m1 = wwv_ld( vroom_neg_two_thirds_m1 ),
    .m2 = wwv_ld( vroom_neg_two_thirds_m2 ) };
  vroom_fp_wide_t w[12], common, flipped;
  vroom_fp_t xm2_1;
  xm2_1.m1 = wwv_add( x->c[1].m1, x->c[1].m1 ); /* xm2_1=2x1, base M. */
  xm2_1.m2 = wwv_add( x->c[1].m2, x->c[1].m2 ); /* xm2_1=2x1, base N. */
  vroom_fp_t xm2_3;
  xm2_3.m1 = wwv_add( x->c[3].m1, x->c[3].m1 ); /* xm2_3=2x3, base M. */
  xm2_3.m2 = wwv_add( x->c[3].m2, x->c[3].m2 ); /* xm2_3=2x3, base N. */
  vroom_fp_t xm2_5;
  xm2_5.m1 = wwv_add( x->c[5].m1, x->c[5].m1 ); /* xm2_5=2x5, base M. */
  xm2_5.m2 = wwv_add( x->c[5].m2, x->c[5].m2 ); /* xm2_5=2x5, base N. */
  vroom_fp_t xm2_7;
  xm2_7.m1 = wwv_add( x->c[7].m1, x->c[7].m1 ); /* xm2_7=2x7, base M. */
  xm2_7.m2 = wwv_add( x->c[7].m2, x->c[7].m2 ); /* xm2_7=2x7, base N. */
  vroom_fp_t xm2_9;
  xm2_9.m1 = wwv_add( x->c[9].m1, x->c[9].m1 ); /* xm2_9=2x9, base M. */
  xm2_9.m2 = wwv_add( x->c[9].m2, x->c[9].m2 ); /* xm2_9=2x9, base N. */
  vroom_fp_t xm2_11;
  xm2_11.m1 = wwv_add( x->c[11].m1, x->c[11].m1 ); /* xm2_11=2x11, base M. */
  xm2_11.m2 = wwv_add( x->c[11].m2, x->c[11].m2 ); /* xm2_11=2x11, base N. */
  vroom_fp_wide_offset( &common ); /* common = 0 mod p before the final scale. */
  vroom_fp_wide_addmul( &common, &x->c[8], &x->c[8] ); /* common += x8*x8. */
  vroom_fp_wide_submul( &common, &x->c[9], &x->c[9] ); /* common -= x9*x9. */
  w[0] = common; /* w0 starts with normalized terms shared by c0 and c1. */
  w[1] = common; /* w1 starts with the same normalized terms. */
  vroom_fp_wide_mul_raw( &flipped, &x->c[8], &xm2_9 ); /* flipped = 2x8*x9. */
  vroom_fp_wide_sub_raw( &w[0], &flipped ); /* w0 -= flipped. */
  vroom_fp_wide_add_raw( &w[1], &flipped ); /* w1 += flipped. */
  vroom_fp_wide_addmul( &w[0], &x->c[0], &neg_two_thirds ); /* w[0] += -2/3*x0. */
  vroom_fp_wide_addmul( &w[0], &x->c[0], &x->c[0] ); /* w[0] += x0*x0. */
  vroom_fp_wide_submul( &w[0], &x->c[1], &x->c[1] ); /* w[0] -= x1*x1. */
  vroom_fp_wide_addmul( &w[1], &x->c[1], &neg_two_thirds ); /* w[1] += -2/3*x1. */
  vroom_fp_wide_addmul( &w[1], &x->c[0], &xm2_1 ); /* w[1] += 2x0*x1. */
  vroom_fp_wide_offset( &common ); /* common = 0 mod p before the final scale. */
  vroom_fp_wide_addmul( &common, &x->c[4], &x->c[4] ); /* common += x4*x4. */
  vroom_fp_wide_submul( &common, &x->c[5], &x->c[5] ); /* common -= x5*x5. */
  w[2] = common; /* w2 starts with normalized terms shared by c2 and c3. */
  w[3] = common; /* w3 starts with the same normalized terms. */
  vroom_fp_wide_mul_raw( &flipped, &x->c[4], &xm2_5 ); /* flipped = 2x4*x5. */
  vroom_fp_wide_sub_raw( &w[2], &flipped ); /* w2 -= flipped. */
  vroom_fp_wide_add_raw( &w[3], &flipped ); /* w3 += flipped. */
  vroom_fp_wide_addmul( &w[2], &x->c[2], &neg_two_thirds ); /* w[2] += -2/3*x2. */
  vroom_fp_wide_addmul( &w[2], &x->c[6], &x->c[6] ); /* w[2] += x6*x6. */
  vroom_fp_wide_submul( &w[2], &x->c[7], &x->c[7] ); /* w[2] -= x7*x7. */
  vroom_fp_wide_addmul( &w[3], &x->c[3], &neg_two_thirds ); /* w[3] += -2/3*x3. */
  vroom_fp_wide_addmul( &w[3], &x->c[6], &xm2_7 ); /* w[3] += 2x6*x7. */
  vroom_fp_wide_offset( &common ); /* common = 0 mod p before the final scale. */
  vroom_fp_wide_addmul( &common, &x->c[10], &x->c[10] ); /* common += x10*x10. */
  vroom_fp_wide_submul( &common, &x->c[11], &x->c[11] ); /* common -= x11*x11. */
  w[4] = common; /* w4 starts with normalized terms shared by c4 and c5. */
  w[5] = common; /* w5 starts with the same normalized terms. */
  vroom_fp_wide_mul_raw( &flipped, &x->c[10], &xm2_11 ); /* flipped = 2x10*x11. */
  vroom_fp_wide_sub_raw( &w[4], &flipped ); /* w4 -= flipped. */
  vroom_fp_wide_add_raw( &w[5], &flipped ); /* w5 += flipped. */
  vroom_fp_wide_addmul( &w[4], &x->c[4], &neg_two_thirds ); /* w[4] += -2/3*x4. */
  vroom_fp_wide_addmul( &w[4], &x->c[2], &x->c[2] ); /* w[4] += x2*x2. */
  vroom_fp_wide_submul( &w[4], &x->c[3], &x->c[3] ); /* w[4] -= x3*x3. */
  vroom_fp_wide_addmul( &w[5], &x->c[5], &neg_two_thirds ); /* w[5] += -2/3*x5. */
  vroom_fp_wide_addmul( &w[5], &x->c[2], &xm2_3 ); /* w[5] += 2x2*x3. */
  vroom_fp_wide_offset( &common ); /* common = 0 mod p before the final scale. */
  vroom_fp_wide_addmul( &common, &x->c[2], &x->c[10] ); /* common += x2*x10. */
  vroom_fp_wide_submul( &common, &x->c[3], &x->c[11] ); /* common -= x3*x11. */
  w[6] = common; /* w6 starts with normalized terms shared by c6 and c7. */
  w[7] = common; /* w7 starts with the same normalized terms. */
  vroom_fp_wide_mul_raw( &flipped, &x->c[2], &x->c[11] ); /* flipped = x2*x11. */
  vroom_fp_wide_addmul( &flipped, &x->c[3], &x->c[10] ); /* flipped += x3*x10. */
  vroom_fp_wide_sub_raw( &w[6], &flipped ); /* w6 -= flipped. */
  vroom_fp_wide_add_raw( &w[7], &flipped ); /* w7 += flipped. */
  vroom_fp_wide_addmul( &w[6], &x->c[6], &one_third ); /* w[6] += 1/3*x6. */
  vroom_fp_wide_addmul( &w[7], &x->c[7], &one_third ); /* w[7] += 1/3*x7. */
  vroom_fp_wide_offset( &common ); /* common = 0 mod p before the final scale. */
  w[8] = common; /* w8 starts with normalized terms shared by c8 and c9. */
  w[9] = common; /* w9 starts with the same normalized terms. */
  vroom_fp_wide_addmul( &w[8], &x->c[8], &one_third ); /* w[8] += 1/3*x8. */
  vroom_fp_wide_addmul( &w[8], &x->c[0], &x->c[8] ); /* w[8] += x0*x8. */
  vroom_fp_wide_submul( &w[8], &x->c[1], &x->c[9] ); /* w[8] -= x1*x9. */
  vroom_fp_wide_addmul( &w[9], &x->c[9], &one_third ); /* w[9] += 1/3*x9. */
  vroom_fp_wide_addmul( &w[9], &x->c[0], &x->c[9] ); /* w[9] += x0*x9. */
  vroom_fp_wide_addmul( &w[9], &x->c[1], &x->c[8] ); /* w[9] += x1*x8. */
  vroom_fp_wide_offset( &common ); /* common = 0 mod p before the final scale. */
  w[10] = common; /* w10 starts with normalized terms shared by c10 and c11. */
  w[11] = common; /* w11 starts with the same normalized terms. */
  vroom_fp_wide_addmul( &w[10], &x->c[10], &one_third ); /* w[10] += 1/3*x10. */
  vroom_fp_wide_addmul( &w[10], &x->c[4], &x->c[6] ); /* w[10] += x4*x6. */
  vroom_fp_wide_submul( &w[10], &x->c[5], &x->c[7] ); /* w[10] -= x5*x7. */
  vroom_fp_wide_addmul( &w[11], &x->c[11], &one_third ); /* w[11] += 1/3*x11. */
  vroom_fp_wide_addmul( &w[11], &x->c[4], &x->c[7] ); /* w[11] += x4*x7. */
  vroom_fp_wide_addmul( &w[11], &x->c[5], &x->c[6] ); /* w[11] += x5*x6. */
  vroom_fp_reduce_wide_scaled_batch6( &out->c[0], &w[0], 3U ); /* out.c0:6 = 3*w0:6 mod p. */
  vroom_fp_reduce_wide_scaled_batch6( &out->c[6], &w[6], 6U ); /* out.c6:12 = 6*w6:12 mod p. */
}
