  fd_bls_fp_wide_sub_raw( &w[0], &flipped ); /* w0 -= flipped. */
  fd_bls_fp_wide_add_raw( &w[1], &flipped ); /* w1 += flipped. */
  fd_bls_fp_wide_addmul( &w[0], &x->c[0], &line[0] ); /* w[0] += x0*l0. */
  fd_bls_fp_wide_addmul( &w[0], &x->c[1], &neg_y[0] ); /* w[0] -= x1*l1. */
  fd_bls_fp_wide_addmul( &w[1], &x->c[0], &line[1] ); /* w[1] += x0*l1. */
  fd_bls_fp_wide_addmul( &w[1], &x->c[1], &line[0] ); /* w[1] += x1*l0. */
