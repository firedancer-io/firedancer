  fd_bls_fp_wide_addmul( &w[5], &x->c[6], &x2[9] ); /* w[5] += 2x6*x9. */
  fd_bls_fp_wide_addmul( &w[5], &x->c[7], &x2[8] ); /* w[5] += 2x7*x8. */
  fd_bls_fp_wide_offset( &common ); /* common = 0 mod p. */
  fd_bls_fp_wide_addmul( &common, &x->c[2], &x2[10] ); /* common += 2x2*x10. */
  fd_bls_fp_wide_addmul( &common, &x->c[3], &neg_x2[5] ); /* common -= 2x3*x11. */
  fd_bls_fp_wide_addmul( &common, &x->c[4], &x2[8] ); /* common += 2x4*x8. */
