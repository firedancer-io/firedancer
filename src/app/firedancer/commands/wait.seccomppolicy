# The wait command attaches to a running validator and waits for a safe
# window (health, leader gap, snapshot idle).  It does not send any
# signals; the validator keeps running.

# logfile_fd: It can be disabled by configuration, but typically tiles
#             will open a log file on boot and write all messages there.
uint logfile_fd

# logging: all log messages are written to a file and/or pipe
#
# 'WARNING' and above are written to the STDERR pipe, while all messages
# are always written to the log file.
#
# Unlike the rest of Firedancer, the wait command uses STDOUT for its
# terminal user interface status display.
#
# arg 0 is the file descriptor to write to.  The boot process ensures
# that descriptor 1 is always STDOUT, and 2 is always STDERR.
write: (or (eq (arg 0) 1)
           (eq (arg 0) 2)
           (eq (arg 0) logfile_fd))

# logging: 'WARNING' and above fsync the logfile to disk immediately
#
# arg 0 is the file descriptor to fsync.
fsync: (eq (arg 0) logfile_fd)

# wait: wait until we need to poll again
#
# fd_log_sleep() uses clock_nanosleep on Linux.  nanosleep is kept as
# a fallback for non-Linux builds.
clock_nanosleep
nanosleep

# wait: signal handler returns
#
# The SIGINT/SIGTERM handler sets a flag and returns (unlike
# monitor_gossip which calls exit(0) from its handler), so
# rt_sigreturn is needed.
rt_sigreturn

# wait: PID-reuse-safe liveness probing
#
# ppoll on the pidfd detects validator exit without PID reuse risk.
# The pidfd becomes readable (POLLIN) when the process terminates.
# arg 1 is the nfds count, always 1 (single pidfd).
ppoll: (eq (arg 1) 1)

# wait: exit the process
#
# After the safe window is found (or on error/interrupt), the wait
# command terminates itself with exit_group().
exit_group
